---
import Icon from './Icon.astro';
import { homeRange as range } from '../data/homeRange';
---
<section class="vehicle-range section-space" id="vehicles" data-section="vehicles" data-explorer aria-labelledby="vehicles-heading">
  <div class="kg-shell">
    <header class="section-heading">
      <div><p class="editorial-label">THE ELECTRIC LINE-UP</p><h2 id="vehicles-heading">Find your kind<br />of electric.<span class="kg-subhead">Electric scooters, e-mopeds and three-wheelers from Kinetic Green.</span></h2></div>
      <p>Different days. Different ambitions.<br />An electric ride that feels like you.</p>
    </header>
    <div class="range-filters" role="group" aria-label="Filter vehicle range">
      <button type="button" data-category="all" aria-pressed="true">All vehicles <span>03</span></button>
      <button type="button" data-category="two" aria-pressed="false">Two-wheelers</button>
      <button type="button" data-category="three" aria-pressed="false">Three-wheelers</button>
    </div>
    <p class="kg-visually-hidden" data-range-status aria-live="polite">Showing all 3 vehicles</p>
    <div class="range-grid">
      {range.map((v, i) => <article class={`range-card range-card--${v.class}`} data-range-category={v.category}>
        <div class="range-card__visual"><span class="range-card__number">0{i + 1}</span><img src={v.image} alt={v.alt} width="800" height="600" loading="lazy" /></div>
        <div class="range-card__body"><p class="editorial-label">{v.label}</p><div class="range-card__title"><h3>{v.name} <span class="range-card__cat">{v.segmentShort}</span></h3><button type="button" class="circle-link" data-product-open={v.id} aria-label={`Discover the ${v.name} ${v.segmentShort}`}><Icon name="diagonal-arrow" size={21} /></button></div><p>{v.line}</p>
          <details class="range-card__fallback"><summary>About {v.name}</summary><p>{v.description}</p></details>
        </div>
      </article>)}
    </div>
    <p class="range-footnote">Model availability and specifications vary by variant. Your dealer can help you choose.</p>
  </div>
  {range.map(v => <dialog class="product-dialog" id={`product-${v.id}`} aria-labelledby={`product-title-${v.id}`}>
    <button type="button" class="dialog-close" data-product-close aria-label="Close vehicle details"><Icon name="close" size={22}/></button>
    <img src={v.image} alt={v.alt} width="800" height="600" loading="lazy" />
    <div class="product-dialog__copy"><p class="editorial-label">KINETIC GREEN</p><h2 id={`product-title-${v.id}`}>{v.name} <span class="kg-dialog-seg">— {v.segment}</span></h2><p>{v.description}</p><ul>{v.features.map(f => <li><Icon name="check" size={16}/>{f}</li>)}</ul><button type="button" class="action-button" data-product-book data-lead-open data-lead-type="test-ride" data-lead-vehicle={v.id} data-lead-source="range">Book a test ride <Icon name="arrow-right" size={18}/></button><p class="fine-print">Confirm current price, range and availability with your dealer.</p></div>
  </dialog>)}
</section>
