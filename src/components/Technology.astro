---
/**
 * Technology — "ELECTRIC IS THE POWER. ENGINEERING IS THE DIFFERENCE."
 * (IA slot 09)
 *
 * Interactive hotspots around a vehicle. Each hotspot opens a technical
 * explanation written in plain language.
 *
 * DATA DISCIPLINE
 * Only hotspots with a confirmed figure show a number. Everything else explains
 * the engineering category without asserting a specification, and carries a
 * visible "confirm with dealer" marker. This is deliberate: a technology section
 * is where EV marketing sites most often invent specs, and that is exactly what
 * damages credibility with an engineering-literate buyer.
 *
 * KEYBOARD / A11Y
 * The hotspots are real <button>s positioned over the visual, in DOM order, and
 * they drive a single detail panel. A <details>/<summary> transcript of every
 * explanation is rendered below for no-JS readers and for search engines.
 */
import Icon from './Icon.astro';
import VehicleVisual from './VehicleVisual.astro';
import { hotspots } from '../data/content';
import { vehicleById } from '../data/vehicles';

const vehicle = vehicleById('eluna-plus')!;
const verified = hotspots.filter((h) => h.verification !== 'pending').length;
---

<section class="kg-tech kg-section kg-section--lg" id="technology" data-section="technology" data-tech>
  <div class="kg-tech__glow" aria-hidden="true"></div>

  <div class="kg-shell">
    <!-- ============================================================== HEAD -->
    <header class="kg-tech__head">
      <p class="kg-eyebrow" data-reveal>Technology</p>
      <h2 class="kg-display kg-tech__title" data-reveal="clip">
        Electric is the power.<br /><span class="kg-accent">Engineering is the difference.</span>
      </h2>
      <p class="kg-lead kg-tech__intro" data-reveal style="--reveal-delay:120ms">
        Six systems decide whether an electric vehicle is pleasant to live with or a compromise.
        Select any hotspot to see what each one does — and what we can confirm about it today.
      </p>
      <p class="kg-tech__integrity" data-reveal style="--reveal-delay:200ms">
        <Icon name="shield" size={14} />
        <span>
          {verified} of {hotspots.length} systems below carry a confirmed figure. The rest are described
          without inventing a specification — confirm exact numbers with your dealer.
        </span>
      </p>
    </header>

    <div class="kg-tech__body">
      <!-- ========================================================== STAGE -->
      <div class="kg-tech__stage">
        <div class="kg-tech__stage-frame">
          <div class="kg-tech__stage-grid" aria-hidden="true"></div>

          <VehicleVisual
            vehicle={vehicle}
            kind="moped"
            variant="hotspot"
            trail
            class="kg-tech__vehicle"
          />

          <!-- ------------------------------------------------ hotspot buttons -->
          <ul class="kg-tech__hotspots" data-tech-hotspots>
            {
              hotspots.map((h, i) => (
                <li class="kg-tech__hotspot" style={`--x:${h.x}%;--y:${h.y}%;--i:${i}`}>
                  <button
                    type="button"
                    class="kg-tech__pin"
                    data-tech-hotspot={h.id}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-controls="tech-detail"
                    data-track="section_view"
                    data-track-section="technology"
                    data-track-source="hotspot"
                  >
                    <span class="kg-tech__pin-ring" aria-hidden="true"></span>
                    <span class="kg-tech__pin-core" aria-hidden="true"></span>
                    <span class="kg-tech__pin-label">{h.label}</span>
                  </button>
                </li>
              ))
            }
          </ul>

          <!-- live status readout in the corner of the stage -->
          <div class="kg-tech__readout" aria-hidden="true">
            <span class="kg-tech__readout-dot"></span>
            <span data-tech-readout>Battery</span>
          </div>
        </div>

        <!-- legend -->
        <p class="kg-tech__legend">
          <span class="kg-tech__legend-item"><i class="kg-tech__legend-dot"></i> Select a system</span>
          <span class="kg-tech__legend-item"><i class="kg-tech__legend-line"></i> Confirm with dealer</span>
        </p>
      </div>

      <!-- ========================================================= DETAIL -->
      <div class="kg-tech__detail">
        <div
          class="kg-tech__detail-card"
          id="tech-detail"
          role="region"
          aria-live="polite"
          aria-label="System detail"
          data-tech-detail
        >
          {
            hotspots.map((h, i) => (
              <article
                class="kg-tech__detail-panel"
                data-tech-panel={h.id}
                data-active={i === 0 ? 'true' : 'false'}
                hidden
              >
                <p class="kg-tech__detail-index">
                  <span>{String(i + 1).padStart(2, '0')}</span>
                  <span class="kg-tech__detail-rule" aria-hidden="true"></span>
                  <span>{h.label}</span>
                </p>

                <h3 class="kg-tech__detail-headline">{h.headline}</h3>
                <p class="kg-tech__detail-body">{h.body}</p>

                {h.specValue ? (
                  <dl class="kg-tech__detail-spec">
                    <dt>{h.specLabel}</dt>
                    <dd>{h.specValue}</dd>
                    <div class="kg-tech__detail-source">
                      <span class={`kg-tag ${h.verification === 'verified' ? 'kg-tag--green' : ''}`}>
                        {h.verification === 'verified' ? 'Confirmed' : 'Indicative'}
                      </span>
                      <span class="kg-tech__detail-src">{h.source}</span>
                    </div>
                  </dl>
                ) : (
                  <p class="kg-tech__detail-pending">
                    <Icon name="info" size={13} />
                    <span>
                      No confirmed figure published for this system yet. We would rather leave it blank
                      than print a number we cannot stand behind — ask your dealer for the current
                      specification.
                    </span>
                  </p>
                )}
              </article>
            ))
          }
        </div>

        <!-- Set expectations for the visitor about what engineering claims mean -->
        <p class="kg-tech__note">
          <Icon name="shield" size={14} />
          <span>
            Engineering descriptions explain how each system works in general terms. They are not a
            warranty or a performance guarantee. Always confirm the specification of the exact variant
            you are buying.
          </span>
        </p>
      </div>
    </div>

    <!-- ============================================ NO-JS / SEO TRANSCRIPT -->
    <details class="kg-tech__transcript">
      <summary>
        <Icon name="file" size={14} />
        Read every system explanation as text
      </summary>
      <ol>
        {
          hotspots.map((h) => (
            <li>
              <h3>{h.label} — {h.headline}</h3>
              <p>{h.body}</p>
              {h.specValue && (
                <p class="kg-tech__transcript-spec">
                  <strong>{h.specLabel}:</strong> {h.specValue} <em>({h.source})</em>
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </details>
  </div>
</section>

<style>
  .kg-tech {
    position: relative;
    background: var(--kg-charcoal);
    color: #fff;
    overflow: hidden;
    --s-bg: var(--kg-charcoal);
    --s-bg-alt: var(--kg-charcoal-2);
    --s-fg: #fff;
    --s-fg-muted: var(--kg-silver);
    --s-fg-subtle: var(--kg-steel);
    --s-line: rgb(255 255 255 / 0.1);
    --s-line-strong: var(--kg-graphite);
    --s-accent: var(--kg-green-400);
    --s-accent-bg: var(--kg-green);
  }
  .kg-tech__glow {
    position: absolute;
    inset-block-start: 10%;
    inset-inline-start: -15%;
    width: 55vw;
    height: 55vw;
    max-width: 780px;
    max-height: 780px;
    background: radial-gradient(circle, rgb(0 200 83 / 0.1) 0%, transparent 68%);
    pointer-events: none;
  }

  /* ------------------------------------------------------------------ head */
  .kg-tech__head {
    position: relative;
    display: grid;
    gap: 0.75rem;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
    max-width: 72ch;
  }
  .kg-tech__title { font-size: var(--fs-d2); max-width: 26ch; }
  .kg-tech__intro { max-width: 56ch; }

  .kg-tech__integrity {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0.75rem 0.875rem;
    background: rgb(0 200 83 / 0.08);
    border-left: 2px solid var(--kg-green);
    border-radius: var(--r-2);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--kg-silver);
    max-width: 66ch;
  }
  .kg-tech__integrity svg { color: var(--kg-green-400); flex: none; margin-block-start: 0.15rem; }

  /* ------------------------------------------------------------------ body */
  .kg-tech__body { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }

  /* ---------------------------------------------------------------- stage */
  .kg-tech__stage { display: grid; gap: 0.875rem; }

  .kg-tech__stage-frame {
    position: relative;
    aspect-ratio: 5 / 4;
    background: linear-gradient(160deg, #1a2027 0%, #0d1013 100%);
    border: 1px solid var(--kg-graphite);
    border-radius: var(--r-4);
    overflow: hidden;
    isolation: isolate;
  }
  .kg-tech__stage-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(94 108 118 / 0.14) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(94 108 118 / 0.14) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 85% 80% at 50% 55%, #000 20%, transparent 82%);
    pointer-events: none;
  }

  .kg-tech__vehicle {
    position: absolute;
    inset-block-end: 4%;
    inset-inline: -6%;
    z-index: 1;
  }

  /* ---------------------------------------------------------------- pins */
  .kg-tech__hotspots { position: absolute; inset: 0; z-index: 3; }

  .kg-tech__hotspot {
    position: absolute;
    inset-block-start: var(--y);
    inset-inline-start: var(--x);
    transform: translate(-50%, -50%);
  }

  .kg-tech__pin {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    color: #fff;
  }

  :global(.js) .kg-tech__hotspot {
    opacity: 0;
    animation: kg-pin-in 0.6s var(--ease-expo) both;
    animation-delay: calc(0.15s + var(--i) * 0.09s);
  }
  @keyframes kg-pin-in {
    from { opacity: 0; transform: translate(-50%, -50%) scale(0.7); }
    to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }

  .kg-tech__pin-ring {
    position: absolute;
    inset: 0;
    border: 1.5px solid rgb(0 200 83 / 0.5);
    border-radius: 50%;
    animation: kg-pin-ping 2.8s var(--ease-snap) infinite;
    animation-delay: calc(var(--i) * 0.4s);
  }
  @keyframes kg-pin-ping {
    0% { transform: scale(0.7); opacity: 0.9; }
    70%, 100% { transform: scale(1.5); opacity: 0; }
  }

  .kg-tech__pin-core {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--kg-green);
    box-shadow: 0 0 0 3px rgb(8 10 9 / 0.65), 0 0 16px 3px rgb(0 200 83 / 0.55);
    transition: transform var(--dur-2) var(--ease-kinetic), background-color var(--dur-2);
  }
  .kg-tech__pin:hover .kg-tech__pin-core { transform: scale(1.25); }

  .kg-tech__pin[aria-pressed='true'] .kg-tech__pin-core {
    background: #fff;
    box-shadow: 0 0 0 4px var(--kg-green), 0 0 24px 6px rgb(0 200 83 / 0.7);
  }
  .kg-tech__pin[aria-pressed='true'] .kg-tech__pin-ring { border-color: #fff; animation: none; opacity: 0.8; }

  .kg-tech__pin-label {
    position: absolute;
    inset-block-start: calc(100% + 2px);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.66);
    white-space: nowrap;
    transition: color var(--dur-2);
    pointer-events: none;
  }
  .kg-tech__pin:hover .kg-tech__pin-label,
  .kg-tech__pin[aria-pressed='true'] .kg-tech__pin-label { color: var(--kg-green-400); }

  .kg-tech__readout {
    position: absolute;
    inset-block-start: 0.875rem;
    inset-inline-start: 0.875rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.65rem;
    background: rgb(8 10 9 / 0.7);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--r-1);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
  }
  .kg-tech__readout-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--kg-green);
    flex: none;
  }

  .kg-tech__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--kg-steel);
  }
  .kg-tech__legend-item { display: inline-flex; align-items: center; gap: 0.4rem; }
  .kg-tech__legend-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--kg-green); }
  .kg-tech__legend-line { width: 14px; height: 0; border-block-start: 2px dashed var(--kg-graphite-2); }

  /* --------------------------------------------------------------- detail */
  .kg-tech__detail { display: grid; gap: 1rem; align-content: start; }

  .kg-tech__detail-card {
    background: rgb(255 255 255 / 0.03);
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: var(--r-4);
    padding: clamp(1.25rem, 3vw, 2rem);
    min-height: 340px;
    position: relative;
    overflow: hidden;
  }
  .kg-tech__detail-card::after {
    content: '';
    position: absolute;
    inset-block-start: -40%;
    inset-inline-end: -20%;
    width: 65%;
    height: 140%;
    background: linear-gradient(118deg, transparent 46%, rgb(0 200 83 / 0.07) 70%, transparent 92%);
    transform: rotate(var(--diag-soft));
    pointer-events: none;
  }

  .kg-tech__detail-panel { animation: kg-tech-in 0.45s var(--ease-expo) both; position: relative; }
  .kg-tech__detail-panel[hidden] { display: none; }
  @keyframes kg-tech-in {
    from { opacity: 0; transform: translateX(14px); }
    to { opacity: 1; transform: none; }
  }

  .kg-tech__detail-index {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--kg-green-400);
  }
  .kg-tech__detail-rule { width: 28px; height: 1px; background: var(--kg-green-a40); flex: none; }

  .kg-tech__detail-headline {
    font-size: clamp(1.25rem, 2.6vw, 1.875rem);
    letter-spacing: -0.025em;
    margin: 0 0 0.75rem;
    max-width: 26ch;
  }

  .kg-tech__detail-body {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--s-fg-muted);
    margin: 0 0 1.25rem;
    max-width: 58ch;
  }

  .kg-tech__detail-spec {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 1rem;
    background: rgb(0 0 0 / 0.28);
    border-left: 2px solid var(--kg-green);
    border-radius: var(--r-2);
  }
  .kg-tech__detail-spec dt {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--kg-steel);
  }
  .kg-tech__detail-spec dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.4vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .kg-tech__detail-source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.6rem;
    padding-block-start: 0.6rem;
    border-block-start: 1px solid rgb(255 255 255 / 0.08);
  }
  .kg-tech__detail-source .kg-tag { color: var(--kg-silver); }
  .kg-tech__detail-source .kg-tag--green { color: var(--kg-green-400); }
  .kg-tech__detail-src { font-size: 0.625rem; color: var(--kg-steel); }

  .kg-tech__detail-pending {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin: 0;
    padding: 0.875rem 1rem;
    background: rgb(255 255 255 / 0.03);
    border: 1px dashed var(--kg-graphite-2);
    border-radius: var(--r-2);
    font-size: 0.75rem;
    line-height: 1.65;
    color: var(--kg-steel);
  }
  .kg-tech__detail-pending svg { flex: none; margin-block-start: 0.15rem; color: var(--kg-green-400); }

  .kg-tech__note {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin: 0;
    font-size: 0.6875rem;
    line-height: 1.65;
    color: var(--kg-steel);
  }
  .kg-tech__note svg { flex: none; margin-block-start: 0.15rem; }

  /* ------------------------------------------------------------ transcript */
  .kg-tech__transcript {
    margin-block-start: clamp(2rem, 5vw, 3rem);
    padding-block-start: 1.5rem;
    border-block-start: 1px solid rgb(255 255 255 / 0.08);
  }
  .kg-tech__transcript summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--kg-silver);
    padding-block: 0.25rem;
    transition: color var(--dur-2);
  }
  .kg-tech__transcript summary:hover { color: var(--kg-green-400); }
  .kg-tech__transcript summary svg { color: var(--kg-green-400); flex: none; }

  .kg-tech__transcript ol {
    display: grid;
    gap: 1.25rem;
    margin-block-start: 1.25rem;
    counter-reset: tech;
  }
  .kg-tech__transcript li {
    padding-inline-start: 1.5rem;
    position: relative;
    border-inline-start: 1px solid rgb(255 255 255 / 0.08);
  }
  .kg-tech__transcript h3 {
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    margin: 0 0 0.35rem;
  }
  .kg-tech__transcript p {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--kg-silver);
    margin: 0;
    max-width: 72ch;
  }
  .kg-tech__transcript-spec { margin-block-start: 0.4rem !important; }
  .kg-tech__transcript-spec em { font-style: normal; color: var(--kg-steel); font-size: 0.75rem; }

  /* ============================================================ RESPONSIVE */
  @media (min-width: 900px) {
    .kg-tech__body { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
    .kg-tech__stage-frame { aspect-ratio: 4 / 3; }
  }

  @media (min-width: 1280px) {
    .kg-tech__body { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .kg-tech__hotspot { animation: none; opacity: 1; }
    .kg-tech__pin-ring { animation: none; }
    .kg-tech__detail-panel { animation: none; }
  }
</style>
