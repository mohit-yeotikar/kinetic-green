<section class="p-close" id="book" data-section="final-cta">
  <div class="kg-shell p-close__inner" data-reveal>
    <p class="p-eyebrow"><span class="dot"></span>Test ride</p>
    <h2 class="p-close__title" data-kinetic>
      <span class="p-close__line">{[...'Ready when'].map((c) => c === ' ' ? <span class="k k--sp">{' '}</span> : <span class="k">{c}</span>)}</span><br />
      <span class="p-close__line">{[...'you are'].map((c) => c === ' ' ? <span class="k k--sp">{' '}</span> : <span class="k">{c}</span>)}<span class="p-hero__stop">.</span></span>
    </h2>
    <div class="p-close__actions">
      <button type="button" class="p-btn p-btn--green p-btn--lg" data-lead-open data-lead-type="test-ride" data-lead-intent="high" data-lead-source="closing" data-lead-vehicle="eluna-plus" data-track="hero_test_ride_click">Book a free test ride<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></button>
      <p class="p-close__note">Takes a minute. A dealer near you confirms the slot. Or call <b>1800-120-4242</b>.</p>
    </div>
  </div>
</section>
