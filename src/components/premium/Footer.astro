---
import Logo from '../Logo.astro';
import { brand } from '../../data/content';
import { PRICE_DISCLAIMER } from '../../data/vehicles';
const year = new Date().getFullYear();
---
<footer class="p-footer">
  <p class="p-tricolour p-tricolour--edge" aria-hidden="true"><i></i><i></i><i></i></p>
  <div class="kg-shell">
    <div class="p-footer__top">
      <a href="#top" class="p-footer__brand" aria-label={`${brand.name} — back to top`}><Logo variant="compact" height={24} /></a>
      <nav class="p-footer__nav" aria-label="Footer">
        <a href="#range">Range</a><a href="#savings">Savings</a><a href="#ownership">Ownership</a><a href="#dealers">Dealers</a>
      </nav>
      <ul class="p-footer__social">
        {brand.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}
      </ul>
    </div>
    <div class="p-footer__bottom">
      <p>© {year} {brand.legalName} · {brand.tagline} · Made in India</p>
      <p class="p-footer__legal">{PRICE_DISCLAIMER} Product figures are manufacturer-claimed or aggregated from public listings and marked indicative until confirmed by Kinetic Green.</p>
      <a href={brand.phoneHref}>{brand.phone}</a>
    </div>
  </div>
</footer>
