---
/**
 * Proof — the one bold green moment on the page. Three brand figures from
 * content.ts (kineticgreen.com brand history), counted up on reveal.
 */
import { metrics } from '../../data/content';
const pick = (id: string) => metrics.find((m) => m.id === id)!;
const rows = [
  { m: pick('dealers'), label: 'dealers, pan India' },
  { m: pick('years'), label: 'years in Indian mobility' },
  { m: pick('distance'), label: 'kilometres ridden electric' },
];
---
<section class="p-proof" id="proof" data-section="proof">
  <div class="kg-shell">
    <p class="p-tricolour" aria-hidden="true" data-reveal><i></i><i></i><i></i></p>
    <p class="p-eyebrow p-eyebrow--on-green" data-reveal><span class="dot"></span>Designed in Pune · Built in Maharashtra · Ridden across India</p>
    <div data-reveal style="--d:80ms"><h2 class="p-h2 p-proof__title">Built by the people who put India on two wheels.</h2></div>
    <ul class="p-proof__grid">
      {rows.map((r, i) => (
        <li data-reveal style={`--d:${160 + i * 90}ms`}>
          <p class="p-proof__num"><span data-odometer={String(r.m.value)}>{r.m.value}</span>{r.m.suffix.replace(' km', '')}</p>
          <p class="p-proof__label">{r.label}</p>
          <span class="kg-visually-hidden">{r.m.sentence}</span>
        </li>
      ))}
    </ul>
    <p class="p-proof__foot" data-reveal style="--d:420ms">Headquartered in Pune, with a plant at Supa, Ahmednagar. Part of the Firodia group, building for Indian roads since the original Luna.</p>
  </div>
</section>
