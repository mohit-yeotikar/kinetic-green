---
/**
 * Hero — one product, one headline, one signature interaction.
 *
 *  • Headline words rise out of clipped lines on load (CSS only).
 *  • The E-Luna sits on a 3D stage that tilts toward the pointer; ghost
 *    wordmark, floor shadow and spec chips sit at different depths so the
 *    scene parallaxes (rAF + lerp, transform only — see scripts/hero.ts).
 *  • Section transition: the stage is pinned for one viewport of scroll while
 *    the next section slides over it as a curtain; the stage scales back and
 *    dims as it is covered.
 *
 * LCP: the vehicle image is the LCP candidate. It is fetchpriority=high,
 * never opacity-animated, and its dimensions are declared to avoid CLS.
 */
import { vehicles, formatINR } from '../../data/vehicles';

const eluna = vehicles.find((v) => v.id === 'eluna-go')!;
const price = formatINR(eluna.priceFrom!);
---
<section class="p-hero" id="top" data-hero>
  <div class="p-hero__pin">
    <div class="p-hero__stage" data-hero-stage>
      <div class="p-hero__head kg-shell">
        <p class="p-eyebrow"><span class="dot"></span>Kinetic Green · E-Luna X3</p>
        <h1 class="p-hero__title">
          <span class="p-hero__line"><span class="p-hero__word" style="--i:0">The icon.</span></span>
          <span class="p-hero__line"><span class="p-hero__word" style="--i:1">Recharged<span class="p-hero__stop">.</span></span></span>
        </h1>
      </div>

      <div class="p-hero__product" data-hero-scene>
        <span class="p-hero__ghost" aria-hidden="true" data-depth="-0.35">E-LUNA</span>
        <div class="p-hero__tilt" data-hero-tilt>
          <div class="p-hero__floor" aria-hidden="true" data-depth="0.5"></div>
          <img
            class="p-hero__vehicle"
            src="/media/eluna-hero.webp"
            width="869"
            height="1000"
            fetchpriority="high"
            decoding="async"
            alt="Kinetic Green E-Luna electric moped in black with a bright green frame, front three-quarter view"
            data-depth="0.9"
          />
        </div>
        <ul class="p-chips" aria-label="E-Luna key figures">
          <li class="p-chip p-chip--tl" style="--i:0" data-depth="1.8"><b><span data-count="110">110</span><small>km</small></b><span>Claimed range</span></li>
          <li class="p-chip p-chip--tr" style="--i:1" data-depth="1.4"><b><span data-count="50">50</span><small>km/h</small></b><span>Top speed</span></li>
          <li class="p-chip p-chip--bl" style="--i:2" data-depth="1.6"><b><span data-count="4">4</span><small>hrs</small></b><span>Home charge, any socket</span></li>
          <li class="p-chip p-chip--br p-chip--price" style="--i:3" data-depth="1.3"><b>{price}</b><span>From · ex-showroom*</span></li>
        </ul>
      </div>

      <div class="p-hero__bottom kg-shell">
        <p class="p-hero__sub">India’s most loved moped, reborn electric. Removable battery, {eluna.specs.rangeKm} km of range, and running costs that make petrol feel expensive.</p>
        <div class="p-hero__actions">
          <button type="button" class="p-btn p-btn--green" data-lead-open data-lead-type="test-ride" data-lead-intent="high" data-lead-source="hero" data-lead-vehicle="eluna-plus" data-track="hero_test_ride_click">
            Book a test ride
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
          </button>
          <a class="p-link" href="#range"><span>Explore the range</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v15"/><path d="m6 13 6 6 6-6"/></svg></a>
        </div>
        <p class="p-partner"><span class="p-partner__mark" aria-hidden="true">TL</span><b>Tonino Lamborghini</b><span>Official partner</span></p>
      </div>
      <div class="p-hero__foot kg-shell">
        <a class="p-scroll" href="#range" aria-label="Scroll to the range"><i aria-hidden="true"></i>Scroll</a>
        <p class="p-made">Made in India · Planet @ our heart</p>
      </div>
    </div>
  </div>
</section>
