---
/**
 * ProductStory — the cinematic E-Luna showcase (IA slot 07).
 *
 * Full-width product storytelling rather than a card wall. On desktop the
 * section pins and vertical scroll drives horizontal travel across five chapters
 * (Design · Utility · Range · Comfort · Technology); the vehicle itself translates
 * at a slightly different rate to the text so the composition has depth.
 *
 * PROGRESSIVE ENHANCEMENT
 * Without JS the rail is a native horizontal scroller (`overflow-x: auto`) with
 * snapping — usable by touch, trackpad and keyboard. The pinned mode is applied
 * only when JS confirms a hover-capable pointer with room, and the rail's height
 * is set from measured content width.
 *
 * SEO
 * Every chapter's copy, every spec and the full vehicle narrative live in the
 * HTML regardless of scroll state. Nothing here is lazily injected.
 */
import Icon from './Icon.astro';
import VehicleVisual from './VehicleVisual.astro';
import { vehicleById, formatINR, RANGE_DISCLAIMER, PRICE_DISCLAIMER } from '../data/vehicles';

const vehicle = vehicleById('eluna-plus')!;

/* ---------------------------------------------------------------------------
   CHAPTERS
   Each chapter is a real content block: a heading, prose, and the specs that
   belong to that aspect of the vehicle. The `focus` field shifts the vehicle's
   presentation so the visual tracks the narrative.
   --------------------------------------------------------------------------- */
interface Chapter {
  id: string;
  label: string;
  index: string;
  headline: string;
  body: string;
  points: string[];
  specs: Array<{ label: string; value: string }>;
  focus: 'full' | 'front' | 'rear' | 'side';
  verified: boolean;
}

const chapters: Chapter[] = [
  {
    id: 'design',
    label: 'Design',
    index: '01',
    headline: 'A shape that has already earned its place.',
    body: 'The Luna silhouette is one of the most recognisable in Indian mobility. The E-Luna keeps the proportions — the step-through frame, the upright posture, the flat floorboard — and re-engineers the middle of the vehicle around a battery pack instead of a fuel tank.',
    points: [
      'Step-through frame with a flat floorboard for everyday practicality',
      'Upright riding position that keeps sightlines clear in dense traffic',
      'Charcoal bodywork with a green drive unit as the visual signature',
    ],
    specs: [
      { label: 'Kerb weight', value: 'From 96 kg' },
      { label: 'Seating', value: '2 riders' },
    ],
    focus: 'full',
    verified: false,
  },
  {
    id: 'utility',
    label: 'Utility',
    index: '02',
    headline: 'Built around the jobs a moped actually does.',
    body: 'A moped in India is not a lifestyle object. It carries a pillion, takes a bag of shopping, runs a delivery, and gets parked wherever there is space. The E-Luna is specified around that reality rather than an idealised urban commute.',
    points: [
      'Rated payload suited to pillion plus luggage duty',
      'Flat floorboard and rear rack for carrying',
      'Low seat height keeps it manageable at low speed and when loaded',
    ],
    specs: [
      { label: 'Payload', value: 'Up to 130 kg (variant dependent)' },
      { label: 'Carrying', value: 'Floorboard + rear rack' },
    ],
    focus: 'side',
    verified: false,
  },
  {
    id: 'range',
    label: 'Range',
    index: '03',
    headline: 'A day of riding on a household socket.',
    body: 'Kinetic Green lists a claimed range of up to 110 km for the E-Luna family, from packs between 2.0 and 2.3 kWh depending on variant. Charge at home, overnight or across a working day — no dedicated infrastructure required.',
    points: [
      'Manufacturer-claimed range of up to 110 km',
      'Charges from a standard 10-ampere household socket',
      'Removable pack means you can charge wherever there is a plug point',
    ],
    specs: [
      { label: 'Claimed range', value: 'Up to 110 km' },
      { label: 'Charge time', value: '4 – 5 hours' },
    ],
    focus: 'rear',
    verified: true,
  },
  {
    id: 'comfort',
    label: 'Comfort',
    index: '04',
    headline: 'Composed on broken roads, not just smooth ones.',
    body: 'Indian road surfaces are the specification. Suspension travel and seat geometry are tuned for potholes, speed breakers and long hours rather than a short ride on fresh tarmac.',
    points: [
      'Telescopic front suspension and twin rear shock absorbers',
      'Long, flat seat that works for rider and pillion',
      'Upright bars reduce fatigue over longer daily distances',
    ],
    specs: [
      { label: 'Front', value: 'Telescopic fork' },
      { label: 'Rear', value: 'Twin shock absorbers' },
    ],
    focus: 'full',
    verified: false,
  },
  {
    id: 'technology',
    label: 'Technology',
    index: '05',
    headline: 'Engineering you can explain.',
    body: 'A brushless hub motor drives the wheel directly. A battery management system keeps the pack inside its safe operating window. Electricity and electronics replace combustion, clutch and gearbox — which is why the drivetrain has far fewer parts that can wear.',
    points: [
      'BLDC hub motor with direct wheel drive and no gearbox',
      'Battery management system monitoring cell temperature and voltage',
      'Regenerative braking returns energy under deceleration',
    ],
    specs: [
      { label: 'Motor', value: 'Up to 2.2 kW (variant dependent)' },
      { label: 'Top speed', value: 'Claimed 50 km/h' },
    ],
    focus: 'front',
    verified: false,
  },
];

const specRows = [
  { label: 'Claimed range', value: vehicle.specs.rangeKm ? `Up to ${vehicle.specs.rangeKm} km` : 'Confirm with dealer' },
  { label: 'Battery', value: `${vehicle.specs.batteryKwh} kWh ${vehicle.specs.batteryType}` },
  { label: 'Motor', value: `${vehicle.specs.motorKw} kW BLDC hub motor` },
  { label: 'Top speed', value: `${vehicle.specs.topSpeedKmph} km/h (claimed)` },
  { label: 'Charge time', value: `${vehicle.specs.chargeTimeHours} hours from a 10A socket` },
  { label: 'Payload', value: `${vehicle.specs.payloadKg} kg` },
];

const schema = {
  '@type': 'Product',
  '@id': 'https://kineticgreen.com/#e-luna-plus',
  name: 'Kinetic Green E-Luna Plus',
  brand: { '@id': 'https://kineticgreen.com/#organization' },
  category: 'Electric Moped',
  description:
    'The Kinetic Green E-Luna Plus is an electric moped built for Indian daily use, with a manufacturer-claimed range of up to 110 km, a 2.3 kWh removable lithium-ion battery and a 2.2 kW hub motor. It charges from a standard 10-ampere household socket.',
  offers: {
    '@type': 'Offer',
    price: vehicle.priceFrom,
    priceCurrency: 'INR',
    availability: 'https://schema.org/InStock',
    priceValidUntil: '2026-12-31',
    url: 'https://kineticgreen.com/#story',
    seller: { '@id': 'https://kineticgreen.com/#organization' },
  },
  additionalProperty: specRows.map((row) => ({
    '@type': 'PropertyValue',
    name: row.label,
    value: row.value,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />

<section
  class="kg-story"
  id="story"
  data-section="product-story"
  data-story
  data-hscroll
  data-section-transition
>
  <!-- ============================== PINNED STAGE ========================= -->
  <div class="kg-story__stage" data-hscroll-stage>
    <!-- fixed backdrop that the chapters travel over -->
    <div class="kg-story__backdrop" aria-hidden="true">
      <div class="kg-story__backdrop-grid"></div>
      <div class="kg-story__backdrop-glow"></div>
    </div>

    <div class="kg-story__head kg-shell">
      <p class="kg-eyebrow">Product story</p>
      <h2 class="kg-display kg-story__title">
        E-Luna.<br /><span class="kg-accent">The icon. Now electric.</span>
      </h2>
      <p class="kg-story__intro">
        One of India&rsquo;s most familiar shapes, re-engineered around a battery. Scroll to move
        through the five things that make it an E-Luna.
      </p>
    </div>

    <!-- ---------------------------------------------- chapter progress rail -->
    <nav class="kg-story__tabs kg-shell" aria-label="Product story chapters">
      <ul>
        {
          chapters.map((ch, i) => (
            <li>
              <button
                type="button"
                class="kg-story__tab"
                data-story-tab={ch.id}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-track="product_story_tab_select"
                data-track-chapter={ch.id}
              >
                <span class="kg-story__tab-index">{ch.index}</span>
                <span class="kg-story__tab-label">{ch.label}</span>
              </button>
            </li>
          ))
        }
      </ul>
      <span class="kg-story__tabs-progress" aria-hidden="true"><i data-story-progress></i></span>
    </nav>

    <!-- ================================== HORIZONTAL TRACK ================= -->
    <div class="kg-story__track-outer">
      <div class="kg-story__track" data-hscroll-track>
        {
          chapters.map((ch, i) => (
            <article class="kg-story__chapter" data-chapter={ch.id} id={`chapter-${ch.id}`}>
              <div class="kg-story__chapter-visual" data-chapter-focus={ch.focus}>
                <VehicleVisual
                  vehicle={vehicle}
                  kind="moped"
                  variant="story"
                  trail={i % 2 === 0}
                  technical
                  sizes="(max-width: 767px) 120vw, (max-width: 1279px) 60vw, 52vw"
                />
              </div>

              <div class="kg-story__chapter-copy">
                <p class="kg-story__chapter-index">
                  <span>{ch.index}</span>
                  <span class="kg-story__chapter-rule" aria-hidden="true"></span>
                  <span>{ch.label}</span>
                </p>

                <h3 class="kg-story__chapter-headline">{ch.headline}</h3>
                <p class="kg-story__chapter-body">{ch.body}</p>

                <ul class="kg-story__points">
                  {ch.points.map((p) => (
                    <li>
                      <Icon name="check" size={14} />
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>

                <dl class="kg-story__chapter-specs">
                  {ch.specs.map((s) => (
                    <div>
                      <dt>{s.label}</dt>
                      <dd>{s.value}</dd>
                    </div>
                  ))}
                </dl>

                {!ch.verified && (
                  <p class="kg-story__verify">
                    <Icon name="info" size={12} />
                    Specification pending final confirmation — verify with your dealer.
                  </p>
                )}
              </div>
            </article>
          ))
        }

        <!-- ------------------------------------------- closing spec panel -->
        <article class="kg-story__chapter kg-story__chapter--spec" id="eluna-specifications">
          <div class="kg-story__chapter-copy">
            <p class="kg-story__chapter-index">
              <span>06</span>
              <span class="kg-story__chapter-rule" aria-hidden="true"></span>
              <span>Specification</span>
            </p>
            <h3 class="kg-story__chapter-headline">
              {vehicle.name}, in full.
            </h3>
            <p class="kg-story__chapter-body">
              Every figure below is published by Kinetic Green or drawn from its official product
              listings. Confirm the exact specification for your variant with your nearest dealer before
              purchase.
            </p>

            <dl class="kg-story__spec-table">
              {
                specRows.map((row) => (
                  <div>
                    <dt>{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))
              }
              <div>
                <dt>Starting price</dt>
                <dd>{vehicle.priceFrom ? formatINR(vehicle.priceFrom) : 'On enquiry'}</dd>
              </div>
            </dl>

            <div class="kg-story__spec-actions">
              <button
                type="button"
                class="kg-btn"
                data-lead-open
                data-lead-type="test-ride"
                data-lead-intent="high"
                data-lead-source="product-story"
                data-lead-vehicle={vehicle.id}
                data-track="test_ride_start"
                data-track-source="product-story"
              >
                <Icon name="calendar" size={16} />
                Book a test ride
              </button>
              <button
                type="button"
                class="kg-btn kg-btn--outline"
                data-lead-open
                data-lead-type="on-road-price"
                data-lead-intent="high"
                data-lead-source="product-story-price"
                data-lead-vehicle={vehicle.id}
                data-track="price_check_start"
                data-track-source="product-story"
              >
                <Icon name="rupee" size={16} />
                Get on-road price
              </button>
            </div>

            <p class="kg-story__disclaimer">
              {RANGE_DISCLAIMER} {PRICE_DISCLAIMER}
            </p>
          </div>
        </article>
      </div>
    </div>

    <!-- --------------------------------------------------- mobile hint -->
    <p class="kg-story__hint kg-shell" aria-hidden="true">
      <Icon name="arrow-right" size={15} />
      Swipe to move through the story
    </p>
  </div>
</section>

<style>
  .kg-story {
    position: relative;
    background: var(--kg-ink);
    color: #fff;
    --s-bg: var(--kg-ink);
    --s-fg: #fff;
    --s-fg-muted: var(--kg-silver);
    --s-fg-subtle: var(--kg-steel);
    --s-line: rgb(255 255 255 / 0.1);
    --s-line-strong: var(--kg-graphite);
    --s-accent: var(--kg-green-400);
    overflow: hidden;
    isolation: isolate;
  }

  /* ------------------------------------------------------------------ stage */
  .kg-story__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--section-y);
    min-height: 100svh;
  }

  /* When JS pins the rail, the stage becomes a sticky viewport-filling window */
  .kg-story[data-hscroll-ready='true'] .kg-story__stage {
    position: sticky;
    inset-block-start: 0;
    height: 100svh;
    padding-block: clamp(3rem, 7vh, 5rem) 0;
    justify-content: flex-start;
    overflow: hidden;
    min-height: 0;
  }

  .kg-story__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .kg-story__backdrop-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(94 108 118 / 0.16) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(94 108 118 / 0.16) 1px, transparent 1px);
    background-size: clamp(48px, 6vw, 96px) clamp(48px, 6vw, 96px);
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, #000 10%, transparent 80%);
  }
  .kg-story__backdrop-glow {
    position: absolute;
    inset-block-end: -25%;
    inset-inline-start: 20%;
    width: 60vw;
    height: 60vw;
    max-width: 820px;
    max-height: 820px;
    background: radial-gradient(circle, rgb(0 200 83 / 0.14) 0%, transparent 66%);
  }

  /* ------------------------------------------------------------------- head */
  .kg-story__head {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.65rem;
    margin-block-end: clamp(1.25rem, 3vh, 2rem);
  }
  .kg-story__title { font-size: var(--fs-d2); }
  .kg-story__intro {
    font-size: var(--fs-lead);
    color: var(--s-fg-muted);
    max-width: 56ch;
  }

  /* ------------------------------------------------------------------- tabs */
  .kg-story__tabs {
    position: relative;
    z-index: 3;
    margin-block-end: clamp(1rem, 2.5vh, 1.5rem);
    padding-block-end: 0.75rem;
  }
  .kg-story__tabs ul {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .kg-story__tabs ul::-webkit-scrollbar { display: none; }

  .kg-story__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0;
    min-height: 40px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--kg-steel);
    white-space: nowrap;
    transition: color var(--dur-2) var(--ease-kinetic);
  }
  .kg-story__tab-index {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    color: var(--kg-graphite-2);
  }
  .kg-story__tab:hover { color: #fff; }
  .kg-story__tab[aria-selected='true'] { color: var(--kg-green-400); }
  .kg-story__tab[aria-selected='true'] .kg-story__tab-index { color: var(--kg-green-400); }

  .kg-story__tabs-progress {
    position: absolute;
    inset-block-end: 0;
    inset-inline: var(--gutter);
    height: 1px;
    background: rgb(255 255 255 / 0.08);
  }
  .kg-story__tabs-progress i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--kg-green);
    transition: width 0.1s linear;
  }

  /* ------------------------------------------------------------------ track */
  .kg-story__track-outer {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .kg-story__track {
    display: flex;
    gap: clamp(1.5rem, 4vw, 4rem);
    /* Native horizontal scroller — the no-JS and touch behaviour */
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: var(--gutter);
    padding-block-end: 1rem;
    will-change: transform;
  }
  .kg-story__track::-webkit-scrollbar { display: none; }

  /* When pinned, the container stops scrolling and the track is translated */
  .kg-story[data-hscroll-ready='true'] .kg-story__track {
    overflow: visible;
    scroll-snap-type: none;
    transition: none;
  }

  /* ---------------------------------------------------------------- chapter */
  .kg-story__chapter {
    flex: none;
    scroll-snap-align: center;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    width: min(88vw, 560px);
  }

  .kg-story__chapter-visual {
    position: relative;
    border-radius: var(--r-4);
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 92%, rgb(0 200 83 / 0.16), transparent 62%);
  }

  /* Focus variants nudge the vehicle's framing so the visual follows the words */
  .kg-story__chapter-visual[data-chapter-focus='front'] { --vv-nudge: -4%; }
  .kg-story__chapter-visual[data-chapter-focus='rear'] { --vv-nudge: 4%; }
  .kg-story__chapter-visual[data-chapter-focus='side'] { --vv-nudge: 0%; }

  .kg-story__chapter-copy { display: grid; gap: 0.75rem; align-content: center; }

  .kg-story__chapter-index {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--kg-green-400);
  }
  .kg-story__chapter-rule {
    width: 32px;
    height: 1px;
    background: var(--kg-green-a40);
    flex: none;
  }

  .kg-story__chapter-headline {
    font-size: clamp(1.375rem, 2.8vw, 2.125rem);
    letter-spacing: -0.025em;
    margin: 0;
    max-width: 24ch;
  }

  .kg-story__chapter-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--s-fg-muted);
    margin: 0;
    max-width: 52ch;
  }

  .kg-story__points { display: grid; gap: 0.5rem; margin-block-start: 0.25rem; }
  .kg-story__points li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.875rem;
    color: var(--s-fg-muted);
  }
  .kg-story__points svg { color: var(--kg-green); flex: none; margin-block-start: 0.25rem; }

  .kg-story__chapter-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0.5rem 0 0;
    border-block: 1px solid rgb(255 255 255 / 0.1);
  }
  .kg-story__chapter-specs > div { padding: 0.7rem 0.75rem 0.7rem 0; }
  .kg-story__chapter-specs dt {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--kg-steel);
    margin-block-end: 0.2rem;
  }
  .kg-story__chapter-specs dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .kg-story__verify {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.6875rem;
    color: var(--kg-steel);
  }
  .kg-story__verify svg { flex: none; margin-block-start: 0.15rem; }

  /* ------------------------------------------------------- closing spec panel */
  .kg-story__chapter--spec { width: min(88vw, 620px); }

  .kg-story__spec-table {
    display: grid;
    gap: 0;
    margin: 0.5rem 0 1rem;
    border-block-start: 1px solid rgb(255 255 255 / 0.1);
  }
  .kg-story__spec-table > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-block-end: 1px solid rgb(255 255 255 / 0.1);
  }
  .kg-story__spec-table dt { font-size: 0.8125rem; color: var(--kg-steel); }
  .kg-story__spec-table dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-align: end;
    color: #fff;
  }

  .kg-story__spec-actions { display: flex; flex-wrap: wrap; gap: 0.625rem; }
  .kg-story__spec-actions .kg-btn--outline {
    --s-fg: #fff;
    --s-line-strong: rgb(255 255 255 / 0.24);
  }
  .kg-story__spec-actions .kg-btn--outline:hover { background: rgb(255 255 255 / 0.06); --s-line-strong: #fff; }

  .kg-story__disclaimer {
    margin: 0.875rem 0 0;
    font-size: 0.625rem;
    line-height: 1.65;
    color: var(--kg-steel);
    max-width: 62ch;
  }

  .kg-story__hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--kg-steel);
  }

  /* ============================================================ RESPONSIVE */
  @media (min-width: 900px) {
    .kg-story__chapter {
      width: min(74vw, 1000px);
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
      gap: clamp(1.5rem, 4vw, 3.5rem);
    }
    .kg-story__chapter--spec {
      width: min(74vw, 900px);
      grid-template-columns: 1fr;
    }
    .kg-story__hint { display: none; }
    .kg-story__spec-table > div { padding: 0.6rem 0; }
  }

  @media (min-width: 1280px) {
    .kg-story__chapter { width: min(72vw, 1180px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .kg-story[data-hscroll-ready='true'] .kg-story__stage { position: relative; height: auto; }
    .kg-story[data-hscroll-ready='true'] .kg-story__track { overflow-x: auto; }
    .kg-story__tabs-progress i { transition: none; }
  }
</style>
