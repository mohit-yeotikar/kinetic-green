const d = paths[name] ?? '<circle cx="12" cy="12" r="8"/>';
const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true', focusable: 'false' };
---

<svg
  class={`kg-icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
  set:html={d}
/>

<style>
  .kg-icon {
    display: block;
    flex: none;
    overflow: visible;
  }
</style>
