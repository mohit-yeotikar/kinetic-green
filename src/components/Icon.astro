---
/**
 * Icon — one inline-SVG sprite source. 24×24 grid, 1.6 stroke, no fills,
 * so icons stay crisp at every size and inherit currentColor.
 *
 * Keeping icons inline (rather than an external sprite or icon font) means
 * they render with the first paint and never cause a layout shift or an
 * extra network round trip.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  /** Decorative by default; pass a label to expose it to AT */
  label?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className = '', label, strokeWidth = 1.6 } = Astro.props;

