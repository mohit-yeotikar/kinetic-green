---
/**
 * DealerFinder — "YOUR NEXT RIDE IS CLOSER THAN YOU THINK." (IA slot 12)
 *
 * A dealer locator that doubles as a lead capture point. The important behaviour:
 * a visitor who searches but does not book still gets a soft capture — "want us to
 * arrange a test ride?" with just name, mobile and city. Searching is intent; not
 * booking yet is not the same as not being interested.
 *
 * DATA HONESTY
 * The roster in content.ts is explicitly a representative sample, not a verified
 * dealer feed, and the UI says so. A locator that silently invents dealer addresses
 * is worse than no locator — it sends customers to places that do not exist.
 *
 * The component ships LocalBusiness/AutomotiveBusiness schema for the dealers it
 * actually renders, so structured data never describes a dealer the page omits.
 */
import Icon from './Icon.astro';
import { dealers, brand } from '../data/content';
import { vehicles } from '../data/vehicles';

/* Cities actually present in the roster, used to drive the typeahead */
const cities = [...new Set(dealers.map((d) => d.city))].sort();

/* A few marquee cities for the quick-pick chips — the ones with real volume */
const popular = ['Pune', 'Mumbai', 'Bengaluru', 'Delhi', 'Hyderabad', 'Chennai', 'Kolkata', 'Ahmedabad'];

/**
 * LocalBusiness schema for the dealers rendered in the initial HTML, so the
 * structured data matches visible content.
 */
const dealerSchema = dealers.slice(0, 12).map((d) => ({
  '@type': ['AutoDealer', 'LocalBusiness'],
  '@id': `${brand.website}/#dealer-${d.id}`,
  name: d.name,
  parentOrganization: { '@id': `${brand.website}/#organization` },
  telephone: d.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: d.city,
    addressRegion: d.state,
    postalCode: d.pincode,
    addressCountry: 'IN',
  },
  areaServed: { '@type': 'City', name: d.city },
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Product',
      name: 'Kinetic Green electric vehicles',
      brand: { '@id': `${brand.website}/#organization` },
    },
  },
}));
---

<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': dealerSchema }).replace(/</g, '\\u003c')} />

<!--
  Data island for the dealer search. Passed as JSON so the client script does not
  need to scrape the DOM (which would break the moment the markup changed) and so
  the roster can be swapped for a live feed by changing one prop.
-->
<script type="application/json" data-dealer-data set:html={JSON.stringify(dealers).replace(/</g, '\\u003c')} />

<section class="kg-dealer kg-section kg-section--lg" id="dealers" data-section="dealers" data-dealer>
  <div class="kg-dealer__grid" aria-hidden="true"></div>

  <div class="kg-shell">
    <!-- ============================================================== HEAD -->
    <header class="kg-dealer__head">
      <p class="kg-eyebrow" data-reveal>Dealer network</p>
      <h2 class="kg-display kg-dealer__title" data-reveal="clip">
        Your next ride<br /><span class="kg-accent">is closer than you think.</span>
      </h2>
      <p class="kg-lead kg-dealer__intro" data-reveal style="--reveal-delay:120ms">
        {dealers.length > 0 ? '550+' : ''} dealers pan India — in metros, tier-two cities and district
        towns, because an electric vehicle has to be serviceable nearby to be worth buying.
      </p>
    </header>

    <div class="kg-dealer__body">
      <!-- =========================================================== SEARCH -->
      <div class="kg-dealer__search">
        <form class="kg-dealer__form" data-dealer-form novalidate>
          <label class="kg-field kg-dealer__field">
            <span class="kg-field__label">Enter your city or PIN code</span>
            <div class="kg-dealer__input-row">
              <div class="kg-dealer__input-wrap">
                <Icon name="search" size={18} />
                <input
                  type="text"
                  class="kg-input"
                  name="query"
                  list="dealer-city-list"
                  placeholder="e.g. Pune, Bengaluru or 411001"
                  autocomplete="address-level2"
                  data-dealer-query
                  aria-describedby="dealer-hint"
                />
              </div>
              <button type="submit" class="kg-btn" data-dealer-submit>
                <Icon name="search" size={16} />
                <span>Search</span>
              </button>
            </div>
            <span class="kg-error" data-dealer-error></span>
          </label>
          <datalist id="dealer-city-list">
            {cities.map((c) => <option value={c} />)}
          </datalist>
          <p class="kg-hint" id="dealer-hint">
            We will show the dealers nearest to you, whether test rides are available, and how far away
            they are.
          </p>
        </form>

        <!-- quick picks -->
        <div class="kg-dealer__quick">
          <p class="kg-label">Popular cities</p>
          <ul class="kg-dealer__chips">
            {
              popular.map((city) => (
                <li>
                  <button
                    type="button"
                    class="kg-dealer__chip"
                    data-dealer-quick={city}
                    data-track="dealer_search"
                    data-track-source="dealer-quickpick"
                    data-track-city={city}
                  >
                    <Icon name="map-pin" size={13} />
                    {city}
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- ---------------------------------------------------------- results -->
        <div class="kg-dealer__results" data-dealer-results hidden aria-live="polite">
          <p class="kg-dealer__results-head">
            <span data-dealer-count>0</span> dealers found
            <span class="kg-dealer__results-note" data-dealer-results-note></span>
          </p>
          <ul class="kg-dealer__list" data-dealer-list></ul>
        </div>

        <!-- -------------------------------------------- soft capture fallback -->
        <div class="kg-dealer__fallback" data-dealer-fallback hidden>
          <p class="kg-dealer__fallback-title">Want us to arrange a test ride?</p>
          <p class="kg-dealer__fallback-body">
            We could not find a dealer in that exact location. Tell us where you are and we will find the
            closest one — or arrange for a vehicle to come to you where that is possible.
          </p>

          <form class="kg-dealer__fallback-form" data-dealer-lead-form novalidate>
            <div class="kg-dealer__fallback-fields">
              <label class="kg-field">
                <span class="kg-field__label">Name <span class="kg-req" aria-hidden="true">*</span></span>
                <input type="text" class="kg-input" name="name" placeholder="Full name" autocomplete="name" required data-dealer-name />
                <span class="kg-error" data-dealer-error-for="name"></span>
              </label>
              <label class="kg-field">
                <span class="kg-field__label">Mobile <span class="kg-req" aria-hidden="true">*</span></span>
                <div class="kg-dealer__prefix-wrap">
                  <span class="kg-dealer__prefix">+91</span>
                  <input
                    type="tel"
                    class="kg-input"
                    name="phone"
                    placeholder="10-digit mobile"
                    autocomplete="tel-national"
                    inputmode="numeric"
                    maxlength="10"
                    required
                    data-dealer-phone
                  />
                </div>
                <span class="kg-error" data-dealer-error-for="phone"></span>
              </label>
              <label class="kg-field">
                <span class="kg-field__label">City <span class="kg-req" aria-hidden="true">*</span></span>
                <input type="text" class="kg-input" name="city" placeholder="Your city" autocomplete="address-level2" required data-dealer-city />
                <span class="kg-error" data-dealer-error-for="city"></span>
              </label>
            </div>

            <label class="kg-check">
              <input type="checkbox" name="whatsapp_consent" data-dealer-whatsapp />
              <span class="kg-check__box" aria-hidden="true"><Icon name="check" size={12} /></span>
              <span class="kg-check__text">Send me updates on WhatsApp <span class="kg-opt">optional</span></span>
            </label>

            <button type="submit" class="kg-btn kg-btn--block" data-dealer-lead-submit>
              <span>Arrange my test ride</span>
              <Icon name="arrow-right" size={16} />
            </button>
          </form>

          <p class="kg-dealer__fallback-msg" data-dealer-lead-msg hidden></p>
        </div>

        <!-- data provenance note -->
        <p class="kg-dealer__caveat">
          <Icon name="info" size={13} />
          <span>
            Dealer records shown here are a representative sample for this demonstration, not a verified
            live directory. Connect the dealer feed before launch — see the README.
          </span>
        </p>
      </div>

      <!-- ===================================================== SUPPORT RAIL -->
      <aside class="kg-dealer__aside">
        <div class="kg-dealer__aside-card">
          <p class="kg-label">Not sure it is for you yet?</p>
          <h3 class="kg-dealer__aside-title">Start with a five-minute conversation.</h3>
          <p class="kg-dealer__aside-body">
            Ask about range on your actual route, what servicing really costs, or whether finance will
            clear. No showroom pressure.
          </p>
          <button
            type="button"
            class="kg-btn"
            data-lead-open
            data-lead-type="callback"
            data-lead-intent="medium"
            data-lead-source="dealer-aside"
            data-track="callback_submit"
            data-track-source="dealer-aside"
          >
            <Icon name="phone" size={16} />
            Request a callback
          </button>
          <a href={brand.phoneHref} class="kg-dealer__aside-phone">
            Or call {brand.phone}
          </a>
        </div>

        <!-- which vehicles a dealer can service is a real question, so we answer it -->
        <div class="kg-dealer__aside-card kg-dealer__aside-card--dark">
          <p class="kg-label">What you can see at a dealer</p>
          <ul class="kg-dealer__aside-list">
            {
              vehicles.slice(0, 5).map((v) => (
                <li>
                  <Icon name="check" size={13} />
                  <span>{v.name}</span>
                </li>
              ))
            }
            <li>
              <Icon name="info" size={13} />
              <span>Availability varies by dealer — call ahead</span>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .kg-dealer {
    position: relative;
    background: var(--kg-mist);
    color: var(--kg-ink);
    overflow: hidden;
    --s-bg: var(--kg-mist);
    --s-bg-alt: #fff;
    --s-fg: var(--kg-ink);
    --s-fg-muted: #55606a;
    --s-fg-subtle: #7e898f;
    --s-line: #e2e8e5;
    --s-line-strong: #cfd8d4;
    --s-accent: var(--kg-green-700);
    --s-accent-bg: var(--kg-green);
  }
  .kg-dealer__grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgb(18 22 26 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(18 22 26 / 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 70% at 30% 30%, #000 10%, transparent 78%);
  }

  /* ------------------------------------------------------------------ head */
  .kg-dealer__head {
    position: relative;
    display: grid;
    gap: 0.75rem;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
    max-width: 68ch;
  }
  .kg-dealer__title { font-size: var(--fs-d2); max-width: 24ch; }
  .kg-dealer__intro { max-width: 56ch; }

  /* ------------------------------------------------------------------ body */
  .kg-dealer__body {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .kg-dealer__search {
    background: #fff;
    border: 1px solid var(--s-line);
    border-radius: var(--r-4);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  /* ---------------------------------------------------------------- input */
  .kg-dealer__input-row {
    display: grid;
    gap: 0.625rem;
  }
  .kg-dealer__input-wrap { position: relative; }
  .kg-dealer__input-wrap > svg {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: 50%;
    transform: translateY(-50%);
    color: var(--s-fg-subtle);
    pointer-events: none;
  }
  .kg-dealer__input-wrap .kg-input { padding-inline-start: 2.75rem; }

  /* ---------------------------------------------------------------- chips */
  .kg-dealer__quick { margin-block-start: 1.5rem; }
  .kg-dealer__chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block-start: 0.625rem; }
  .kg-dealer__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    min-height: 42px;
    background: var(--kg-mist);
    border: 1px solid var(--s-line);
    border-radius: var(--r-2);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--s-fg-muted);
    transition: all var(--dur-2) var(--ease-kinetic);
  }
  .kg-dealer__chip svg { color: var(--kg-green-700); flex: none; }
  .kg-dealer__chip:hover {
    border-color: var(--kg-green);
    background: var(--kg-green-050);
    color: var(--kg-ink);
    transform: translateY(-1px);
  }

  /* -------------------------------------------------------------- results */
  .kg-dealer__results { margin-block-start: 1.75rem; }
  .kg-dealer__results[hidden] { display: none; }

  .kg-dealer__results-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.875rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--s-line);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--s-fg-subtle);
  }
  .kg-dealer__results-head span:first-child { color: var(--kg-green-700); font-weight: 700; }
  .kg-dealer__results-note { margin-inline-start: auto; text-transform: none; letter-spacing: 0; }

  .kg-dealer__list { display: grid; gap: 0.75rem; }

  /* dealer card — rendered by JS, styled here so markup stays lean */
  :global(.kg-dealer__item) {
    display: grid;
    gap: 0.875rem;
    padding: 1.125rem;
    background: var(--kg-mist);
    border: 1px solid var(--s-line);
    border-radius: var(--r-3);
    transition: border-color var(--dur-2) var(--ease-kinetic), background-color var(--dur-2), transform var(--dur-3) var(--ease-expo);
  }
  :global(.kg-dealer__item:hover) {
    border-color: var(--kg-green);
    background: #fff;
    transform: translateY(-2px);
  }
  :global(.kg-dealer__item-head) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  :global(.kg-dealer__item-name) {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 0.2rem;
  }
  :global(.kg-dealer__item-addr) {
    font-size: 0.8125rem;
    color: var(--s-fg-muted);
    margin: 0;
  }
  :global(.kg-dealer__item-dist) {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--kg-green-700);
    background: var(--kg-green-050);
    border: 1px solid var(--kg-green-a24);
    border-radius: var(--r-1);
    padding: 0.25rem 0.5rem;
    white-space: nowrap;
  }
  :global(.kg-dealer__item-tags) { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  :global(.kg-dealer__item-actions) {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 520px) {
    :global(.kg-dealer__item-actions) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  :global(.kg-dealer__item-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.65rem 0.75rem;
    min-height: 44px;
    border: 1px solid var(--s-line-strong);
    border-radius: var(--r-2);
    background: #fff;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--s-fg-muted);
    transition: all var(--dur-2) var(--ease-kinetic);
  }
  :global(.kg-dealer__item-btn:hover) {
    border-color: var(--kg-ink);
    color: var(--kg-ink);
    transform: translateY(-1px);
  }
  :global(.kg-dealer__item-btn--primary) {
    background: var(--kg-green);
    border-color: var(--kg-green);
    color: #00240f;
  }
  :global(.kg-dealer__item-btn--primary:hover) {
    background: var(--kg-green-400);
    border-color: var(--kg-green-400);
    color: #00240f;
  }
  :global(.kg-dealer__item-btn svg) { flex: none; }

  /* ------------------------------------------------------------- fallback */
  .kg-dealer__fallback {
    margin-block-start: 1.75rem;
    padding: clamp(1.125rem, 3vw, 1.5rem);
    background: var(--kg-green-050);
    border: 1px solid var(--kg-green-a24);
    border-radius: var(--r-3);
    border-left: 3px solid var(--kg-green);
  }
  .kg-dealer__fallback[hidden] { display: none; }
  .kg-dealer__fallback-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0 0 0.4rem;
  }
  .kg-dealer__fallback-body {
    font-size: 0.875rem;
    line-height: 1.65;
    color: #2c3a33;
    margin: 0 0 1.25rem;
    max-width: 60ch;
  }
  .kg-dealer__fallback-fields { display: grid; gap: 0; }
  .kg-dealer__prefix-wrap { position: relative; }
  .kg-dealer__prefix {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--s-fg-muted);
    pointer-events: none;
  }
  .kg-dealer__prefix-wrap .kg-input { padding-inline-start: 3.75rem; }
  .kg-dealer__fallback .kg-input { background: #fff; }
  .kg-dealer__fallback-msg {
    margin: 1rem 0 0;
    padding: 0.75rem 0.875rem;
    background: #fff;
    border-left: 2px solid var(--kg-green);
    border-radius: var(--r-2);
    font-size: 0.8125rem;
    color: var(--kg-ink);
  }
  .kg-dealer__fallback-msg[hidden] { display: none; }

  .kg-dealer__caveat {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--s-line);
    font-size: 0.6875rem;
    line-height: 1.65;
    color: var(--s-fg-subtle);
  }
  .kg-dealer__caveat svg { flex: none; margin-block-start: 0.15rem; color: var(--kg-green-700); }

  /* --------------------------------------------------------------- aside */
  .kg-dealer__aside { display: grid; gap: 1rem; }

  .kg-dealer__aside-card {
    padding: clamp(1.125rem, 3vw, 1.75rem);
    background: #fff;
    border: 1px solid var(--s-line);
    border-radius: var(--r-4);
  }
  .kg-dealer__aside-card--dark {
    background: linear-gradient(155deg, var(--kg-charcoal) 0%, var(--kg-ink) 100%);
    color: #fff;
    border-color: var(--kg-graphite);
  }
  .kg-dealer__aside-card--dark .kg-label { color: var(--kg-green-400); }

  .kg-dealer__aside-title {
    font-size: clamp(1.125rem, 2.2vw, 1.4375rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0.5rem 0 0.6rem;
    max-width: 20ch;
  }
  .kg-dealer__aside-body {
    font-size: 0.875rem;
    line-height: 1.68;
    color: var(--s-fg-muted);
    margin: 0 0 1.25rem;
  }
  .kg-dealer__aside-card--dark .kg-dealer__aside-body { color: var(--kg-silver); }

  .kg-dealer__aside-phone {
    display: inline-block;
    margin-block-start: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--kg-green-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .kg-dealer__aside-list { display: grid; gap: 0.5rem; margin-block-start: 0.875rem; }
  .kg-dealer__aside-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--kg-silver);
  }
  .kg-dealer__aside-list svg { color: var(--kg-green); flex: none; }
  .kg-dealer__aside-list li:last-child { color: var(--kg-steel); font-size: 0.75rem; }

  /* ============================================================ RESPONSIVE */
  @media (min-width: 640px) {
    .kg-dealer__input-row { grid-template-columns: 1fr auto; }
    .kg-dealer__fallback-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1rem; }
    .kg-dealer__fallback-fields > .kg-field:last-child { grid-column: 1 / -1; }
  }

  @media (min-width: 1024px) {
    .kg-dealer__body { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); }
    .kg-dealer__aside { position: sticky; inset-block-start: 6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kg-dealer__chip:hover,
    :global(.kg-dealer__item:hover) { transform: none; }
  }
</style>
