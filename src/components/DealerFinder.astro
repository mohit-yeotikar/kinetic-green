---
import Icon from './Icon.astro';
import { brand } from '../data/content';
---
<section class="dealer-section" id="dealers" data-section="dealers" data-dealer>
  <div class="kg-shell dealer-layout">
    <div class="dealer-heading"><p class="editorial-label">LET’S MEET IN REAL LIFE</p><h2>Your next ride.<br />Closer than you think.</h2><p>See it. Sit on it. Take it for a spin.<br />Start by finding a Kinetic Green dealer near you.</p></div>
    <div class="dealer-search">
      <form data-dealer-form action="https://www.google.com/maps/search/" method="get" target="_blank" rel="noopener noreferrer">
        <label for="dealer-city">Where would you like to ride?</label>
        <div class="dealer-search__input"><Icon name="map-pin" size={20}/><input id="dealer-city" name="query" type="text" placeholder="Enter your city or PIN code" required minlength="2" maxlength="80" autocomplete="address-level2" data-dealer-query/><button type="submit" aria-label="Find Kinetic Green dealers on Google Maps"><Icon name="arrow-right" size={22}/></button></div>
        <p class="fine-print" id="dealer-search-note">Opens Google Maps. Confirm dealership status and test-ride availability before visiting.</p>
      </form>
      <div class="dealer-popular"><span>Try</span>{['Pune','Bengaluru','Delhi'].map(city => <button type="button" data-dealer-city={city}>{city}</button>)}</div>
      <a class="dealer-phone" href={brand.phoneHref}><Icon name="phone" size={17}/> Prefer a conversation? <b>{brand.phone}</b></a>
    </div>
  </div>
</section>
