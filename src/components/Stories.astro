---
/**
 * Stories — "KINETIC STORIES" (IA slot 13)
 *
 * Editorial, not "Latest News". A horizontal rail of large-photography cards with
 * real category filtering (Product · People · Technology · Mobility · Business).
 *
 * DATA HONESTY
 * Every story here traces to a Kinetic Green published announcement, and each card
 * links to the source. No invented editorial is attributed to the company. Cards
 * without an editorial image render an original vector placeholder rather than a
 * mismatched stock photo — which is why `image` is null for most of them.
 *
 * Filtering is progressive: without JS all cards are visible in a plain list.
 */
import Icon from './Icon.astro';
import { stories, storyCategories, faqs, brand } from '../data/content';

const featured = stories.find((s) => s.featured) ?? stories[0];
const rest = stories.filter((s) => s.id !== featured.id);

/* Category → a deterministic accent so the rail reads as a system */
const categoryTone: Record<string, string> = {
  Product: 'var(--kg-green)',
  Technology: 'var(--kg-green-400)',
  Mobility: 'var(--kg-metal-2)',
  Business: 'var(--kg-green-200)',
  People: 'var(--kg-metal-3)',
};
---

<section class="kg-stories kg-section kg-section--lg" id="stories" data-section="stories" data-stories>
  <div class="kg-shell">
    <!-- ============================================================== HEAD -->
    <header class="kg-stories__head">
      <div>
        <p class="kg-eyebrow" data-reveal>Kinetic stories</p>
        <h2 class="kg-display kg-stories__title" data-reveal="clip">
          Movement,<br /><span class="kg-accent">documented.</span>
        </h2>
      </div>

      <!-- ------------------------------------------------ category filter -->
      <div class="kg-stories__filter" role="group" aria-label="Filter stories by category" data-stories-filter>
        {
          storyCategories.map((cat) => (
            <button
              type="button"
              class="kg-stories__filter-btn"
              data-story-filter={cat}
              aria-pressed={cat === 'All' ? 'true' : 'false'}
              data-track="story_click"
              data-track-source="stories-filter"
              data-track-category={cat}
            >
              {cat}
            </button>
          ))
        }
      </div>
    </header>

    <!-- ========================================================== FEATURED -->
    <article class="kg-stories__feature" data-story-card={featured.category} data-reveal>
      <div class="kg-stories__feature-visual">
        {
          featured.image ? (
            <img
              src={featured.image}
              alt=""
              width="1200"
              height="675"
              loading="lazy"
              decoding="async"
            />
          ) : (
            /* Original vector placeholder — no mismatched stock photography */
            <div class="kg-stories__placeholder" aria-hidden="true">
              <span class="kg-stories__placeholder-mark"></span>
              <span class="kg-stories__placeholder-rule"></span>
              <span class="kg-stories__placeholder-rule kg-stories__placeholder-rule--short"></span>
              <span class="kg-stories__placeholder-word">{featured.category}</span>
            </div>
          )
        }
        <span class="kg-stories__feature-tag" style={`--tone:${categoryTone[featured.category]}`}>
          {featured.category}
        </span>
      </div>

      <div class="kg-stories__feature-copy">
        <p class="kg-stories__date">{featured.date}</p>
        <h3 class="kg-stories__feature-title">
          <a
            href={featured.href}
            target="_blank"
            rel="noopener noreferrer"
            data-track="story_click"
            data-track-source="stories-featured"
            data-track-story={featured.id}
          >
            {featured.title}
            <Icon name="external" size={16} />
          </a>
        </h3>
        <p class="kg-stories__feature-excerpt">{featured.excerpt}</p>
        <p class="kg-stories__source">
          <Icon name="external" size={12} />
          <span>Source: Kinetic Green announcement</span>
        </p>
      </div>
    </article>

    <!-- ============================================================== RAIL -->
    <ul class="kg-stories__rail" data-stories-rail>
      {
        rest.map((s, i) => (
          <li class="kg-stories__item" data-story-card={s.category} style={`--i:${i}`}>
            <article class="kg-stories__card">
              <div class="kg-stories__card-visual">
                {s.image ? (
                  <img src={s.image} alt="" width="800" height="500" loading="lazy" decoding="async" />
                ) : (
                  <div class="kg-stories__placeholder kg-stories__placeholder--sm" aria-hidden="true">
                    <span class="kg-stories__placeholder-word">{s.category}</span>
                  </div>
                )}
                <span class="kg-stories__card-tag" style={`--tone:${categoryTone[s.category]}`}>
                  {s.category}
                </span>
              </div>

              <div class="kg-stories__card-copy">
                <p class="kg-stories__date">{s.date}</p>
                <h3 class="kg-stories__card-title">
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track="story_click"
                    data-track-source="stories-rail"
                    data-track-story={s.id}
                  >
                    {s.title}
                  </a>
                </h3>
                <p class="kg-stories__card-excerpt">{s.excerpt}</p>
                <span class="kg-stories__card-more">
                  Read more
                  <Icon name="arrow-right" size={14} />
                </span>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="kg-stories__empty" data-stories-empty hidden>
      No stories in that category yet.
    </p>

    <!-- --------------------------------------------------------- FAQ block
         Placed here because it answers the same "why should I trust you"
         question the editorial section is answering. Rendered as <details> so it
         is indexable and works without JS, and mirrored into FAQPage schema. -->
    <div class="kg-stories__faq" id="faq" data-section="faq">
      <header class="kg-stories__faq-head">
        <p class="kg-eyebrow">Questions</p>
        <h2 class="kg-stories__faq-title">Answered plainly.</h2>
        <p class="kg-stories__faq-intro">
          The questions buyers actually ask, with the honest answers — including the ones that are
          &ldquo;confirm this with your dealer&rdquo;.
        </p>
      </header>

      <div class="kg-stories__faq-list" data-faq-list>
        {
          faqs.map((f, i) => (
            <details class="kg-faq" data-faq-item data-reveal style={`--reveal-delay:${i * 40}ms`}>
              <summary class="kg-faq__q" data-track="faq_open" data-track-question={f.q.slice(0, 40)}>
                <span>{f.q}</span>
                <span class="kg-faq__icon" aria-hidden="true">
                  <Icon name="plus" size={16} />
                </span>
              </summary>
              <div class="kg-faq__a">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .kg-stories {
    background: var(--kg-charcoal);
    color: #fff;
    --s-bg: var(--kg-charcoal);
    --s-bg-alt: var(--kg-charcoal-2);
    --s-fg: #fff;
    --s-fg-muted: var(--kg-silver);
    --s-fg-subtle: var(--kg-steel);
    --s-line: rgb(255 255 255 / 0.1);
    --s-line-strong: var(--kg-graphite);
    --s-accent: var(--kg-green-400);
    --s-accent-bg: var(--kg-green);
  }

  /* ------------------------------------------------------------------ head */
  .kg-stories__head {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-block-end: clamp(1.75rem, 4vw, 2.75rem);
  }
  .kg-stories__title { font-size: var(--fs-d2); }

  .kg-stories__filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .kg-stories__filter-btn {
    padding: 0.5rem 0.85rem;
    min-height: 42px;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--r-full);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--kg-silver);
    transition: all var(--dur-2) var(--ease-kinetic);
  }
  .kg-stories__filter-btn:hover {
    border-color: var(--kg-green-a40);
    background: var(--kg-green-a12);
    color: #fff;
  }
  .kg-stories__filter-btn[aria-pressed='true'] {
    background: var(--kg-green);
    border-color: var(--kg-green);
    color: #00240f;
  }

  /* -------------------------------------------------------------- featured */
  .kg-stories__feature {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-block-end: clamp(1.75rem, 4vw, 2.75rem);
    margin-block-end: clamp(1.75rem, 4vw, 2.75rem);
    border-block-end: 1px solid rgb(255 255 255 / 0.1);
  }
  .kg-stories__feature[hidden] { display: none; }

  .kg-stories__feature-visual {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--r-4);
    overflow: hidden;
    background: linear-gradient(150deg, #1b2127 0%, #0e1215 100%);
    border: 1px solid var(--kg-graphite);
  }
  .kg-stories__feature-visual img { width: 100%; height: 100%; object-fit: cover; }

  /* Original placeholder art — an engineered card, not a stock photo */
  .kg-stories__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    background:
      linear-gradient(118deg, transparent 40%, rgb(0 200 83 / 0.1) 66%, transparent 90%),
      repeating-linear-gradient(
        -45deg,
        rgb(255 255 255 / 0.02) 0 2px,
        transparent 2px 14px
      );
  }
  .kg-stories__placeholder-mark {
    width: 34px;
    height: 34px;
    background: var(--kg-green);
    transform: rotate(45deg);
    opacity: 0.85;
  }
  .kg-stories__placeholder-rule {
    display: block;
    height: 2px;
    width: min(60%, 340px);
    background: rgb(255 255 255 / 0.16);
  }
  .kg-stories__placeholder-rule--short { width: min(34%, 190px); }
  .kg-stories__placeholder-word {
    font-family: var(--font-mono);
    font-size: clamp(0.625rem, 1.4vw, 0.8125rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.28);
    margin-block-start: 0.5rem;
  }
  .kg-stories__placeholder--sm { padding: 1.25rem; gap: 0.5rem; }
  .kg-stories__placeholder--sm .kg-stories__placeholder-word { margin-block-start: 0; font-size: 0.625rem; }

  .kg-stories__feature-tag,
  .kg-stories__card-tag {
    position: absolute;
    inset-block-start: 0.875rem;
    inset-inline-start: 0.875rem;
    padding: 0.3rem 0.6rem;
    background: rgb(8 10 9 / 0.7);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-left: 2px solid var(--tone, var(--kg-green));
    border-radius: var(--r-1);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
  }

  .kg-stories__feature-copy { display: grid; gap: 0.6rem; align-content: center; }
  .kg-stories__date {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--kg-steel);
  }
  .kg-stories__feature-title {
    font-size: clamp(1.375rem, 3.4vw, 2.375rem);
    letter-spacing: -0.028em;
    margin: 0;
    max-width: 24ch;
  }
  .kg-stories__feature-title a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    transition: color var(--dur-2) var(--ease-kinetic);
  }
  .kg-stories__feature-title a:hover { color: var(--kg-green-400); }
  .kg-stories__feature-title svg { flex: none; align-self: center; opacity: 0.5; }
  .kg-stories__feature-excerpt {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--kg-silver);
    margin: 0;
    max-width: 56ch;
  }
  .kg-stories__source {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--kg-steel);
  }
  .kg-stories__source svg { flex: none; }

  /* ------------------------------------------------------------------ rail */
  .kg-stories__rail {
    display: grid;
    gap: clamp(0.875rem, 2vw, 1.25rem);
    grid-template-columns: 1fr;
  }
  .kg-stories__item[hidden] { display: none; }

  .kg-stories__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: rgb(255 255 255 / 0.03);
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: var(--r-4);
    overflow: hidden;
    transition: border-color var(--dur-3) var(--ease-kinetic), transform var(--dur-3) var(--ease-expo);
  }
  .kg-stories__card:hover { border-color: var(--kg-green-a40); transform: translateY(-4px); }

  .kg-stories__card-visual {
    position: relative;
    aspect-ratio: 16 / 10;
    background: linear-gradient(150deg, #1b2127 0%, #0e1215 100%);
    overflow: hidden;
  }
  .kg-stories__card-visual img { width: 100%; height: 100%; object-fit: cover; }

  .kg-stories__card-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
    padding: 1.125rem 1.25rem 1.375rem;
  }
  .kg-stories__card-title {
    font-size: 1.0625rem;
    letter-spacing: -0.018em;
    margin: 0;
    max-width: 26ch;
  }
  .kg-stories__card-title a { transition: color var(--dur-2); }
  .kg-stories__card-title a:hover { color: var(--kg-green-400); }
  .kg-stories__card-excerpt {
    font-size: 0.8125rem;
    line-height: 1.66;
    color: var(--kg-silver);
    margin: 0;
    flex: 1;
  }
  .kg-stories__card-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-block-start: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--kg-green-400);
  }
  .kg-stories__card-more svg { transition: transform var(--dur-2) var(--ease-kinetic); }
  .kg-stories__card:hover .kg-stories__card-more svg { transform: translateX(4px); }

  .kg-stories__empty {
    margin-block-start: 1.5rem;
    padding: 1.25rem;
    background: rgb(255 255 255 / 0.03);
    border: 1px dashed var(--kg-graphite-2);
    border-radius: var(--r-3);
    font-size: 0.875rem;
    color: var(--kg-steel);
  }
  .kg-stories__empty[hidden] { display: none; }

  /* ================================================================== FAQ */
  .kg-stories__faq {
    margin-block-start: clamp(3rem, 8vw, 6rem);
    padding-block-start: clamp(2rem, 5vw, 3.5rem);
    border-block-start: 1px solid rgb(255 255 255 / 0.1);
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .kg-stories__faq-title {
    font-size: var(--fs-d3);
    text-transform: uppercase;
    letter-spacing: -0.028em;
    margin: 0.6rem 0 0.6rem;
  }
  .kg-stories__faq-intro {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--kg-silver);
    margin: 0;
    max-width: 44ch;
  }

  .kg-stories__faq-list { display: grid; gap: 0; border-block-start: 1px solid rgb(255 255 255 / 0.1); }

  .kg-faq { border-block-end: 1px solid rgb(255 255 255 / 0.1); }

  .kg-faq__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.125rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 1.7vw, 1.125rem);
    font-weight: 600;
    letter-spacing: -0.012em;
    color: #fff;
    transition: color var(--dur-2);
  }
  .kg-faq__q::-webkit-details-marker { display: none; }
  .kg-faq__q:hover { color: var(--kg-green-400); }

  .kg-faq__icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: none;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--r-1);
    color: var(--kg-green-400);
    transition: transform var(--dur-3) var(--ease-expo), background-color var(--dur-2), border-color var(--dur-2);
  }
  .kg-faq[open] .kg-faq__icon {
    transform: rotate(135deg);
    background: var(--kg-green-a12);
    border-color: var(--kg-green-a40);
  }

  .kg-faq__a { overflow: hidden; }
  .kg-faq__a p {
    margin: 0;
    padding-block-end: 1.375rem;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--kg-silver);
    max-width: 82ch;
  }
  .kg-faq[open] .kg-faq__a { animation: kg-faq-in var(--dur-4) var(--ease-expo) both; }
  @keyframes kg-faq-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  /* ============================================================ RESPONSIVE */
  @media (min-width: 640px) {
    .kg-stories__rail { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 900px) {
    .kg-stories__head { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: end; }
    .kg-stories__filter { justify-content: flex-end; }
    .kg-stories__feature { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: center; }
    .kg-stories__rail { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .kg-stories__faq { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); }
  }

  @media (min-width: 1280px) {
    .kg-stories__rail { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .kg-stories__card:hover { transform: none; }
    .kg-faq[open] .kg-faq__a { animation: none; }
  }
</style>
