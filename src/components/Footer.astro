---
/**
 * Footer — the navigational close (IA slot 16).
 *
 * Structured as four link columns plus a contact rail, because a footer's job on
 * a conversion-led homepage is to catch the visitor who scrolled past everything
 * without converting. That visitor is usually not ready to book — they are
 * looking for something specific: a vehicle, a service centre, a career page.
 *
 * So the columns are organised by *intent* rather than by internal org chart:
 *   Vehicles    → what we make
 *   Experience  → what I want to do next   (the conversion column)
 *   Company     → who are you
 *   Support     → I need help right now
 *
 * The "Experience" column deliberately duplicates the primary funnel actions
 * (test ride / dealer / savings / finance / service). Repeating a conversion
 * route in the footer is not redundancy — it is the last chance to convert a
 * visitor who has read the whole page and is now deciding.
 *
 * The Kinetic Green diagonal is carried through as a section-top edge so the
 * footer reads as part of the brand's geometry rather than a generic dark block.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { brand } from '../data/content';
import { vehicles, priceableVehicles } from '../data/vehicles';

/* Group the lineup by the shape of the vehicle, not by SKU — a footer is a map,
   not a catalogue. */
const vehicleLinks = [
  { label: 'E-Luna', href: '#vehicles', note: 'The icon, electric' },
  { label: 'Electric Scooters', href: '#vehicles', note: 'Everyday commuting' },
  { label: 'Three Wheelers', href: '#vehicles', note: 'Passenger and cargo' },
  { label: 'Commercial Vehicles', href: '#vehicles', note: 'Built to earn' },
];

const experienceLinks = [
  { label: 'Book a Test Ride', href: '#book', lead: 'test-ride' },
  { label: 'Find a Dealer', href: '#dealers' },
  { label: 'Calculate Savings', href: '#calculator' },
  { label: 'Finance Options', href: '#finance' },
  { label: 'Find Your EV', href: '#find-your-ev' },
  { label: 'Service & Support', href: '#ownership' },
];

const companyLinks = [
  { label: 'About Kinetic Green', href: '#legacy' },
  { label: 'Leadership', href: '#legacy' },
  { label: 'Technology', href: '#technology' },
  { label: 'Kinetic Stories', href: '#stories' },
  { label: 'Careers', href: `${brand.website}/careers` },
  { label: 'Contact', href: '#enquire' },
];

const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Use', href: '/terms' },
  { label: 'Cookie Policy', href: '/cookies' },
];

const year = new Date().getFullYear();

/* Vehicle names are pulled from data so the footer cannot list a model the
   company no longer sells — or miss one it does. */
const modelCount = vehicles.length;
const priceableCount = priceableVehicles.length;
---

<footer class="kg-foot" id="footer" data-surface="ink" data-section="footer">
  <!-- ============================================== DIAGONAL SECTION EDGE -->
  <div class="kg-foot__edge" aria-hidden="true">
    <span class="kg-foot__edge-line"></span>
  </div>

  <div class="kg-shell">
    <!-- ======================================================== TOP / BRAND -->
    <div class="kg-foot__top">
      <div class="kg-foot__brand">
        <a href="#top" class="kg-foot__logo" aria-label={`${brand.name} — back to top`}>
          <Logo variant="full" height={34} reverse />
        </a>
        <p class="kg-foot__tagline">{brand.tagline}</p>
        <p class="kg-foot__blurb">
          Electric mobility engineered for the way India moves. {modelCount} models across two- and
          three-wheelers, backed by a dealer network of 550+ touchpoints and five decades of
          mobility experience.
        </p>

        <!-- Contact is given prominence because a phone call is the highest-value
             action available to someone who has read to the bottom of the page. -->
        <div class="kg-foot__contact">
          <a href={brand.phoneHref} class="kg-foot__contact-item" data-track="footer_link_click" data-track-source="footer-phone">
            <span class="kg-foot__contact-icon"><Icon name="phone" size={16} /></span>
            <span class="kg-foot__contact-body">
              <span class="kg-foot__contact-label">Customer care</span>
              <span class="kg-foot__contact-value">{brand.phone}</span>
            </span>
          </a>
          <a href={`mailto:${brand.email}`} class="kg-foot__contact-item" data-track="footer_link_click" data-track-source="footer-email">
            <span class="kg-foot__contact-icon"><Icon name="mail" size={16} /></span>
            <span class="kg-foot__contact-body">
              <span class="kg-foot__contact-label">Email</span>
              <span class="kg-foot__contact-value">{brand.email}</span>
            </span>
          </a>
        </div>

        <!-- Social -->
        <ul class="kg-foot__social" aria-label="Kinetic Green on social media">
          {
            brand.social.map((s) => (
              <li>
                <a
                  href={s.href}
                  class="kg-foot__social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  data-track="footer_link_click"
                  data-track-source={`footer-social-${s.icon}`}
                >
                  <Icon name={s.icon} size={18} label={s.label} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- ============================================================ COLUMNS -->
      <nav class="kg-foot__cols" aria-label="Footer">
        <div class="kg-foot__col">
          <h2 class="kg-foot__col-title">Vehicles</h2>
          <ul class="kg-foot__list">
            {
              vehicleLinks.map((l) => (
                <li>
                  <a href={l.href} class="kg-foot__link" data-track="footer_link_click" data-track-source="footer-vehicles">
                    <span class="kg-foot__link-label">{l.label}</span>
                    <span class="kg-foot__link-note">{l.note}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="kg-foot__col-note">
            {priceableCount} of {modelCount} models with a published starting price.
          </p>
        </div>

        <div class="kg-foot__col">
          <h2 class="kg-foot__col-title">Experience</h2>
          <ul class="kg-foot__list">
            {
              experienceLinks.map((l) =>
                l.lead ? (
                  <li>
                    <button
                      type="button"
                      class="kg-foot__link kg-foot__link--action"
                      data-lead-open
                      data-lead-type={l.lead}
                      data-lead-intent="high"
                      data-lead-source="footer"
                      data-track="footer_link_click"
                      data-track-source="footer-experience"
                    >
                      <span class="kg-foot__link-label">{l.label}</span>
                      <Icon name="arrow-right" size={15} />
                    </button>
                  </li>
                ) : (
                  <li>
                    <a href={l.href} class="kg-foot__link" data-track="footer_link_click" data-track-source="footer-experience">
                      <span class="kg-foot__link-label">{l.label}</span>
                    </a>
                  </li>
                ),
              )
            }
          </ul>
        </div>

        <div class="kg-foot__col">
          <h2 class="kg-foot__col-title">Company</h2>
          <ul class="kg-foot__list">
            {
              companyLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="kg-foot__link"
                    data-track="footer_link_click"
                    data-track-source="footer-company"
                  >
                    <span class="kg-foot__link-label">{l.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="kg-foot__col">
          <h2 class="kg-foot__col-title">Support</h2>
          <ul class="kg-foot__list">
            <li>
              <a href={brand.phoneHref} class="kg-foot__link" data-track="footer_link_click" data-track-source="footer-support">
                <span class="kg-foot__link-label">Customer care</span>
                <span class="kg-foot__link-note">{brand.phone}</span>
              </a>
            </li>
            <li>
              <button
                type="button"
                class="kg-foot__link kg-foot__link--action"
                data-lead-open
                data-lead-type="service"
                data-lead-intent="high"
                data-lead-source="footer-support"
                data-track="callback_submit"
                data-track-source="footer-support"
              >
                <span class="kg-foot__link-label">Service request</span>
                <Icon name="arrow-right" size={15} />
              </button>
            </li>
            <li>
              <button
                type="button"
                class="kg-foot__link kg-foot__link--action"
                data-lead-open
                data-lead-type="commercial"
                data-lead-intent="business"
                data-lead-source="footer-business"
                data-track="business_enquiry_start"
                data-track-source="footer-business"
              >
                <span class="kg-foot__link-label">Fleet &amp; commercial enquiry</span>
                <Icon name="arrow-right" size={15} />
              </button>
            </li>
            <li>
              <button
                type="button"
                class="kg-foot__link kg-foot__link--action"
                data-lead-open
                data-lead-type="dealership"
                data-lead-intent="business"
                data-lead-source="footer-dealership"
                data-track="business_enquiry_start"
                data-track-source="footer-dealership"
              >
                <span class="kg-foot__link-label">Become a dealer</span>
                <Icon name="arrow-right" size={15} />
              </button>
            </li>
            <li>
              <a href="#faq" class="kg-foot__link" data-track="footer_link_click" data-track-source="footer-support">
                <span class="kg-foot__link-label">Questions, answered</span>
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </div>

    <!-- ==================================================== BOTTOM / LEGAL -->
    <div class="kg-foot__bottom">
      <p class="kg-foot__copy">
        &copy; {year} {brand.legalName}. All rights reserved.
      </p>

      <ul class="kg-foot__legal">
        {
          legalLinks.map((l) => (
            <li>
              <a href={l.href} class="kg-foot__legal-link" data-track="footer_link_click" data-track-source="footer-legal">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="kg-foot__disclaimer">
        Vehicle images and illustrations on this site are original technical artwork, not photographs of
        production vehicles. Specifications, prices and availability are indicative, vary by variant,
        city and state subsidy, and must be confirmed with your nearest {brand.name} dealer. Savings and
        finance figures shown anywhere on this site are illustrative estimates and are not a quotation,
        an offer of credit, or a guarantee.
      </p>
    </div>
  </div>
</footer>

<style>
  /* ==========================================================================
     FOOTER — the darkest surface on the page, so the page ends by receding.
     ========================================================================== */
  .kg-foot {
    position: relative;
    background: var(--kg-ink);
    color: var(--s-fg);
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2rem, 4vw, 2.5rem);
    overflow: hidden;
  }

  /* ------------------------------------------------------ diagonal section edge
     The brand's forward cut, reused as the transition from the last section into
     the footer. Drawn as a skewed plane rather than a clip-path so it can carry
     its own hairline and glow. */
  .kg-foot__edge {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 1px;
  }
  .kg-foot__edge-line {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--kg-green-a40) 18%,
      var(--kg-green) 42%,
      var(--kg-green-a40) 62%,
      transparent
    );
  }
  .kg-foot__edge::after {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 38%;
    height: 1px;
    background: var(--kg-green);
    transform: skewX(var(--diag, -12deg));
    opacity: 0.85;
  }

  /* ====================================================================== TOP */
  .kg-foot__top {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    padding-block-end: clamp(2.5rem, 5vw, 3.5rem);
    border-block-end: 1px solid var(--s-line);
  }

  /* ------------------------------------------------------------------- brand */
  .kg-foot__brand { max-width: 34rem; }
  .kg-foot__logo { display: inline-block; margin-block-end: 1.25rem; }
  .kg-foot__tagline {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--kg-green-400);
    margin-block-end: 0.875rem;
  }
  .kg-foot__blurb {
    color: var(--s-fg-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: 38ch;
    margin-block-end: 1.75rem;
  }

  /* ----------------------------------------------------------------- contact */
  .kg-foot__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-end: 1.75rem;
  }
  .kg-foot__contact-item {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--s-line-strong);
    background: rgb(255 255 255 / 0.02);
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-snap), background var(--dur-2) var(--ease-snap);
  }
  .kg-foot__contact-item:hover {
    border-color: var(--kg-green-a40);
    background: rgb(0 200 83 / 0.05);
  }
  .kg-foot__contact-icon {
    display: grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    flex: none;
    background: var(--kg-green-a12);
    color: var(--kg-green-400);
  }
  .kg-foot__contact-body { display: grid; gap: 0.1rem; }
  .kg-foot__contact-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--s-fg-subtle);
  }
  .kg-foot__contact-value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--s-fg);
  }

  /* ------------------------------------------------------------------ social */
  .kg-foot__social {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .kg-foot__social-link {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--s-line-strong);
    color: var(--s-fg-muted);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-snap), border-color var(--dur-2) var(--ease-snap),
      background var(--dur-2) var(--ease-snap);
  }
  .kg-foot__social-link:hover {
    color: var(--kg-green-400);
    border-color: var(--kg-green-a40);
    background: rgb(0 200 83 / 0.06);
  }

  /* ---------------------------------------------------------------- columns */
  .kg-foot__cols {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
    grid-template-columns: 1fr;
  }
  .kg-foot__col-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--s-fg-subtle);
    margin-block-end: 1rem;
    font-weight: 500;
  }
  .kg-foot__list {
    display: grid;
    gap: 0.125rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .kg-foot__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    padding: 0.4rem 0;
    background: none;
    border: 0;
    text-align: left;
    font: inherit;
    color: var(--s-fg-muted);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--dur-2) var(--ease-snap);
  }
  .kg-foot__link:hover { color: var(--kg-green-400); }
  .kg-foot__link:hover .kg-foot__link-label { transform: translateX(2px); }
  .kg-foot__link-label {
    font-size: 0.9375rem;
    transition: transform var(--dur-2) var(--ease-snap);
  }
  .kg-foot__link-note {
    display: block;
    font-size: 0.75rem;
    color: var(--s-fg-subtle);
    margin-block-start: 0.05rem;
  }
  .kg-foot__link--action { color: var(--s-fg); }
  .kg-foot__link--action svg {
    flex: none;
    color: var(--kg-green-400);
    transition: transform var(--dur-2) var(--ease-snap);
  }
  .kg-foot__link--action:hover svg { transform: translateX(3px); }

  /* Links with a note need to stack their label + note */
  .kg-foot__link:has(.kg-foot__link-note) { align-items: flex-start; }

  .kg-foot__col-note {
    margin-block-start: 1rem;
    font-size: 0.75rem;
    color: var(--s-fg-subtle);
    line-height: 1.5;
  }

  /* =================================================================== BOTTOM */
  .kg-foot__bottom {
    display: grid;
    gap: 1rem;
    padding-block-start: clamp(1.5rem, 3vw, 2rem);
  }
  .kg-foot__copy {
    font-size: 0.8125rem;
    color: var(--s-fg-subtle);
    margin: 0;
  }
  .kg-foot__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .kg-foot__legal-link {
    font-size: 0.8125rem;
    color: var(--s-fg-subtle);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-snap);
  }
  .kg-foot__legal-link:hover { color: var(--kg-green-400); }

  /* The disclaimer is not fine print to be hidden — on an EV site it is the
     single most important honest statement on the page, so it gets real size
     and a readable measure rather than being shrunk to 10px grey. */
  .kg-foot__disclaimer {
    max-width: 92ch;
    margin: 0;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--s-line);
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--s-fg-subtle);
  }

  /* ============================================================ BREAKPOINTS */
  @media (min-width: 48rem) {
    .kg-foot__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kg-foot__bottom {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
    .kg-foot__disclaimer { grid-column: 1 / -1; }
  }

  @media (min-width: 64rem) {
    .kg-foot__top {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      align-items: start;
    }
    .kg-foot__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (min-width: 90rem) {
    .kg-foot__top { grid-template-columns: minmax(0, 26rem) minmax(0, 1fr); }
  }

  /* Touch targets: 44px minimum on coarse pointers. */
  @media (hover: none) and (pointer: coarse) {
    .kg-foot__link { padding-block: 0.7rem; }
    .kg-foot__legal-link { padding-block: 0.5rem; display: inline-block; }
  }
</style>
