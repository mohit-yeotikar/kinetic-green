---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { brand } from '../data/content';
---
<footer class="site-footer" id="footer">
  <div class="kg-shell">
    <div class="site-footer__main"><a href="#top" aria-label="Kinetic Green home"><Logo variant="compact" height={29}/></a><p>Planet @ our heart.</p><nav aria-label="Footer"><a href="#vehicles">Our vehicles</a><a href="#ownership">Ownership</a><a href={`mailto:${brand.email}`}>Contact us</a></nav><div class="site-footer__social">{brand.social.slice(0,3).map(s => <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer"><Icon name={s.icon} size={19}/></a>)}</div></div>
    <div class="site-footer__bottom"><p>© {new Date().getFullYear()} Kinetic Green. All rights reserved.</p><p>Design preview · Product details subject to dealer confirmation.</p><a href="#top">Back to top <Icon name="arrow-up" size={14}/></a></div>
  </div>
</footer>
