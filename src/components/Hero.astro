---
import Icon from './Icon.astro';
---
<section class="campaign-hero" id="top" data-section="hero" data-hero>
  <div class="campaign-hero__inner kg-shell">
    <div class="campaign-hero__copy">
      <p class="editorial-label"><span class="status-dot"></span> A new energy for everyday</p>
      <h1>Go your<br />own way<span class="green-stop">.</span></h1>
      <p class="campaign-hero__description">The icon you know. The electric life you’ll love.<br class="desktop-break" /> Meet the Kinetic Green E-Luna.</p>
      <div class="campaign-hero__actions">
        <button type="button" class="action-button" data-lead-open data-lead-type="test-ride" data-lead-intent="high" data-lead-source="hero" data-lead-vehicle="eluna-plus" data-track="hero_test_ride_click">Book a test ride <Icon name="arrow-up-right" size={18} /></button>
        <a class="text-link" href="#vehicles">Explore the range <Icon name="arrow-down" size={16} /></a>
      </div>
    </div>
    <div class="campaign-hero__art">
      <span class="campaign-hero__word" aria-hidden="true">e-Luna</span>
      <div class="campaign-hero__orbit" aria-hidden="true"></div>
      <img class="campaign-hero__vehicle" src="/media/eluna-hero.webp" width="869" height="1000" fetchpriority="high" alt="Kinetic Green E-Luna with a vivid green frame, shown from the front three-quarter angle" />
      <p class="campaign-hero__caption"><span>THE E-LUNA</span><span>Familiar soul. Electric heart.</span></p>
    </div>
  </div>
  <div class="campaign-hero__foot kg-shell">
    <span>INDIAN ROOTS. ELECTRIC FUTURE.</span>
    <p>For your everyday. And the world we share.</p>
    <a href="#vehicles" aria-label="Scroll to our electric vehicle range"><Icon name="arrow-down" size={19} /></a>
  </div>
</section>
