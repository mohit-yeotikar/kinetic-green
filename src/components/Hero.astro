---
/**
 * Hero — cinematic full-viewport opening.
 *
 * Composition (desktop): asymmetric 5/7 split. Copy column occupies the left
 * rail; the vehicle breaks out of the grid entirely and travels in from the
 * lower-left, so it reads as entering the frame rather than being placed in a
 * banner. Depth comes from four stacked layers: atmospheric gradient → technical
 * grid → energy trail → vehicle → foreground light bloom.
 *
 * SEO: the H1, the supporting paragraph and the tertiary savings link are all
 * static HTML. Nothing above the fold depends on JS to be readable.
 *
 * PERFORMANCE: no raster hero image ships by default (the vehicle is vector), so
 * LCP is a text paint, not an image decode. If a photographic hero is supplied
 * later, BaseLayout preloads it and this component switches to <picture>.
 */
import Icon from './Icon.astro';
import VehicleVisual from './VehicleVisual.astro';
import { brand } from '../data/content';
import { vehicleById } from '../data/vehicles';

const heroVehicle = vehicleById('eluna-plus')!;
const [eyebrowTop, eyebrowSub] = brand.heroEyebrow;
const hasHeroPhoto = Boolean(heroVehicle.media.poster);
---

<section class="kg-hero" id="top" data-section="hero" data-hero>
  <!-- ======================= ATMOSPHERIC LAYERS (parallax) ================= -->
  <div class="kg-hero__atmos" aria-hidden="true">
    <div class="kg-hero__grad" data-parallax="0.06"></div>
    <div class="kg-hero__grid" data-parallax="0.10"></div>
    <div class="kg-hero__glow" data-parallax="0.14"></div>
    <!-- Signature diagonal energy plane — the logo's forward cut, at scale -->
    <div class="kg-hero__cut" data-parallax="0.22">
      <span class="kg-hero__cut-line"></span>
    </div>
    <div class="kg-hero__vignette"></div>
  </div>

  <div class="kg-hero__inner kg-shell">
    <!-- ============================== COPY RAIL ============================ -->
    <div class="kg-hero__copy">
      <p class="kg-hero__eyebrow" data-hero-eyebrow>
        <span class="kg-hero__eyebrow-top">{eyebrowTop}</span>
        <span class="kg-hero__eyebrow-rule" aria-hidden="true"></span>
        <span class="kg-hero__eyebrow-sub">{eyebrowSub}</span>
      </p>

      <!--
        The H1 is split into two masked lines. Without JS the full sentence is
        still present and readable; with JS each line rises out of a mask.
        Critically, the text is in the DOM once — never duplicated for
        animation — so the accessible name and the SEO text stay identical.
      -->
      <h1 class="kg-hero__title" data-hero-title>
        <span class="kg-line-mask" style="--line-delay: 620ms">
          <span>Move</span>
        </span>
        <span class="kg-line-mask kg-hero__title-accent" style="--line-delay: 720ms">
          <span>Different<span class="kg-hero__period">.</span></span>
        </span>
      </h1>

      <p class="kg-hero__sub" data-hero-sub>
        {brand.heroSecondary}
      </p>

      <!-- ------------------------------- CTAs ------------------------------ -->
      <div class="kg-hero__ctas" data-hero-ctas>
        <button
          type="button"
          class="kg-btn kg-btn--lg"
          data-lead-open
          data-lead-type="test-ride"
          data-lead-intent="high"
          data-lead-source="hero"
          data-lead-vehicle={heroVehicle.id}
          data-track="hero_test_ride_click"
        >
          <Icon name="calendar" size={18} />
          Book a Test Ride
        </button>

        <a
          href="#vehicles"
          class="kg-btn kg-btn--lg kg-btn--outline"
          data-track="hero_explore_click"
          data-track-source="hero"
        >
          Explore Vehicles
          <Icon name="arrow-down" size={18} />
        </a>
      </div>

      <!-- --------------------------- tertiary path ------------------------- -->
      <a
        href="#calculator"
        class="kg-hero__tertiary"
        data-track="hero_calculator_click"
        data-track-source="hero"
      >
        <span class="kg-hero__tertiary-icon"><Icon name="calculator" size={16} /></span>
        <span class="kg-hero__tertiary-text">
          <span class="kg-hero__tertiary-label">Calculate your savings</span>
          <span class="kg-hero__tertiary-meta">See what electric could put back in your pocket</span>
        </span>
        <Icon name="arrow-right" size={16} class="kg-hero__tertiary-arrow" />
      </a>
    </div>

    <!-- ============================ PRODUCT STAGE ========================== -->
    <div class="kg-hero__stage" data-hero-stage>
      <div class="kg-hero__vehicle" data-parallax="0.05">
        <VehicleVisual
          vehicle={heroVehicle}
          kind="moped"
          variant="hero"
          priority={hasHeroPhoto}
          trail
          sizes="(max-width: 767px) 130vw, (max-width: 1279px) 80vw, 62vw"
        />
      </div>

      <!-- Floating specification chips — real data, positioned off the vehicle -->
      <ul class="kg-hero__chips" aria-hidden="true">
        <li class="kg-hero__chip" style="--i: 0" data-parallax="0.10">
          <span class="kg-hero__chip-label">Claimed range</span>
          <span class="kg-hero__chip-value">{heroVehicle.specs.rangeKm}<em>km</em></span>
        </li>
        <li class="kg-hero__chip" style="--i: 1" data-parallax="0.16">
          <span class="kg-hero__chip-label">Charge</span>
          <span class="kg-hero__chip-value">{heroVehicle.specs.chargeTimeHours}<em>hrs</em></span>
        </li>
        <li class="kg-hero__chip kg-hero__chip--green" style="--i: 2" data-parallax="0.13">
          <span class="kg-hero__chip-label">Starting from</span>
          <span class="kg-hero__chip-value">₹79,990<em>ex-sh.</em></span>
        </li>
      </ul>
    </div>
  </div>

  <!-- ======================== SCROLL INDICATOR + TRUST ===================== -->
  <div class="kg-hero__foot kg-shell">
    <p class="kg-scroll-hint">
      <span class="kg-scroll-hint__text">Scroll to explore</span>
      <span class="kg-scroll-hint__track" aria-hidden="true"><i></i></span>
    </p>

    <ul class="kg-hero__trust">
      <li><Icon name="building" size={14} /> 50+ years of operations</li>
      <li><Icon name="map-pin" size={14} /> 550+ dealers pan India</li>
      <li><Icon name="leaf" size={14} /> Planet @ our heart</li>
    </ul>
  </div>
</section>

<style>
  /* ============================================================ SHELL */
  .kg-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--kg-ink);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    padding-block-start: clamp(6rem, 14vh, 9rem);
    padding-block-end: clamp(4.5rem, 10vh, 6rem);
  }

  /* ---------------------------------------------------------- atmosphere */
  .kg-hero__atmos {
    position: absolute;
    inset: -10%;
    z-index: 0;
    pointer-events: none;
  }

  /* Base gradient: charcoal with a green-tinted floor, not a "green website" wash */
  .kg-hero__grad {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 120% 80% at 78% 62%, rgb(0 200 83 / 0.16) 0%, transparent 62%),
      radial-gradient(ellipse 90% 60% at 12% 18%, rgb(60 72 82 / 0.5) 0%, transparent 70%),
      linear-gradient(168deg, #0B0E10 0%, #12161A 46%, #080A09 100%);
    will-change: transform;
  }

  .kg-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(94 108 118 / 0.22) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(94 108 118 / 0.22) 1px, transparent 1px);
    background-size: clamp(56px, 7vw, 108px) clamp(56px, 7vw, 108px);
    /* Fade the grid out where it would fight the type */
    mask-image:
      radial-gradient(ellipse 70% 85% at 74% 58%, #000 0%, transparent 72%),
      linear-gradient(to bottom, transparent 0%, #000 30%, #000 70%, transparent 100%);
    mask-composite: intersect;
    opacity: 0.5;
    will-change: transform;
  }

  .kg-hero__glow {
    position: absolute;
    inset-block-end: -18%;
    inset-inline-end: -6%;
    width: 68vw;
    height: 68vw;
    max-width: 1100px;
    max-height: 1100px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(0 200 83 / 0.20) 0%, transparent 66%);
    filter: blur(30px);
    will-change: transform;
  }

  /* The signature diagonal — a thin green plane cutting the whole viewport */
  .kg-hero__cut {
    position: absolute;
    inset-inline-start: 46%;
    inset-block: -20%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(0 200 83 / 0.05) 20%,
      rgb(0 200 83 / 0.55) 52%,
      rgb(0 200 83 / 0.12) 82%,
      transparent 100%
    );
    transform: rotate(var(--diag-soft));
    transform-origin: center;
    will-change: transform;
  }
  .kg-hero__cut-line {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 2px;
    height: 0;
    background: var(--kg-green);
    box-shadow: 0 0 24px 2px rgb(0 200 83 / 0.7);
    /* Draws downward on load, then retracts — "energy travelling" */
    animation: kg-cut-sweep 2.4s var(--ease-expo) 0.5s both;
  }
  @keyframes kg-cut-sweep {
    0% { height: 0; inset-block-start: 50%; opacity: 0; }
    18% { opacity: 1; }
    55% { height: 46%; inset-block-start: 27%; opacity: 1; }
    100% { height: 100%; inset-block-start: 0%; opacity: 0.12; }
  }

  .kg-hero__vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgb(8 10 9 / 0.92) 0%, rgb(8 10 9 / 0.55) 34%, transparent 62%),
      linear-gradient(to top, rgb(8 10 9 / 0.96) 0%, transparent 34%),
      linear-gradient(to bottom, rgb(8 10 9 / 0.7) 0%, transparent 22%);
  }

  /* ================================================================ LAYOUT */
  .kg-hero__inner {
    position: relative;
    z-index: 2;
    flex: 1;
    display: grid;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    width: 100%;
    /* Single column on mobile — stage sits above the copy at reduced scale */
    grid-template-columns: 1fr;
    grid-template-areas:
      'stage'
      'copy';
    padding-block: clamp(1rem, 4vh, 2rem);
  }

  .kg-hero__copy { grid-area: copy; position: relative; z-index: 3; }
  .kg-hero__stage { grid-area: stage; position: relative; }

  /* ================================================================== COPY */
  .kg-hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
    margin-block-end: clamp(1rem, 2.5vh, 1.75rem);
  }
  .js .kg-hero__eyebrow { animation: kg-fade-up 0.9s var(--ease-expo) 0.1s both; }
  .kg-hero__eyebrow-top { color: #fff; font-weight: 500; }
  .kg-hero__eyebrow-rule {
    width: clamp(20px, 4vw, 48px);
    height: 1px;
    background: var(--kg-green);
    flex: none;
  }
  .kg-hero__eyebrow-sub { color: var(--kg-green-400); }

  .kg-hero__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-mega);
    line-height: var(--leading-mega);
    letter-spacing: var(--tracking-mega);
    text-transform: uppercase;
    margin: 0;
    /* Optical alignment: pull the display face left so the stem meets the rail */
    margin-inline-start: -0.02em;
  }
  .kg-hero__title-accent { color: var(--kg-green); }
  .kg-hero__period { color: rgb(255 255 255 / 0.45); }

  /* Per-line stagger handled by --line-delay inline style */
  .js .kg-hero__title .kg-line-mask > span {
    animation: kg-line-rise 1.05s var(--ease-expo) both;
    animation-delay: var(--line-delay);
  }
  @keyframes kg-line-rise {
    from { transform: translateY(108%); }
    to { transform: translateY(0); }
  }

  .kg-hero__sub {
    font-size: clamp(1.05rem, 1.6vw, 1.45rem);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.72);
    max-width: 34ch;
    margin-block-start: clamp(1rem, 2.5vh, 1.5rem);
  }
  .js .kg-hero__sub { animation: kg-fade-up 1s var(--ease-expo) 0.85s both; }

  /* ----------------------------------------------------------------- CTAs */
  .kg-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: clamp(1.5rem, 4vh, 2.5rem);
  }
  .js .kg-hero__ctas { animation: kg-fade-up 1s var(--ease-expo) 1s both; }

  .kg-hero__ctas .kg-btn--outline {
    --s-fg: #fff;
    --s-line-strong: rgb(255 255 255 / 0.28);
    backdrop-filter: blur(6px);
  }
  .kg-hero__ctas .kg-btn--outline:hover {
    --s-line-strong: #fff;
    background: rgb(255 255 255 / 0.06);
    box-shadow: none;
  }

  /* ---------------------------------------------------------- tertiary link */
  .kg-hero__tertiary {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    margin-block-start: clamp(1.25rem, 3vh, 1.75rem);
    padding: 0.5rem 0.75rem 0.5rem 0.5rem;
    border-radius: var(--r-3);
    border: 1px solid transparent;
    transition: border-color var(--dur-2) var(--ease-kinetic), background-color var(--dur-2);
  }
  .js .kg-hero__tertiary { animation: kg-fade-up 1s var(--ease-expo) 1.15s both; }
  .kg-hero__tertiary:hover {
    border-color: rgb(0 200 83 / 0.34);
    background: rgb(0 200 83 / 0.07);
  }
  .kg-hero__tertiary-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: var(--r-2);
    background: rgb(0 200 83 / 0.14);
    color: var(--kg-green-400);
  }
  .kg-hero__tertiary-text { display: flex; flex-direction: column; gap: 0.1rem; }
  .kg-hero__tertiary-label {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }
  .kg-hero__tertiary-meta { font-size: 0.75rem; color: rgb(255 255 255 / 0.52); }
  .kg-hero__tertiary-arrow {
    margin-inline-start: 0.25rem;
    color: var(--kg-green-400);
    transition: transform var(--dur-2) var(--ease-kinetic);
  }
  .kg-hero__tertiary:hover .kg-hero__tertiary-arrow { transform: translateX(4px); }

  /* ================================================================= STAGE */
  .kg-hero__stage {
    position: relative;
    /* The vehicle deliberately overflows its grid cell — it enters the screen */
    width: min(150%, 900px);
    margin-inline-start: -12%;
  }

  .kg-hero__vehicle { position: relative; will-change: transform; }

  /* ----------------------------------------------------------------- chips */
  .kg-hero__chips {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: none;
  }
  .kg-hero__chip {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.85rem;
    background: rgb(8 10 9 / 0.62);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-left: 2px solid var(--kg-green);
    border-radius: var(--r-2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    will-change: transform;
  }
  .kg-hero__chip:nth-child(1) { inset-block-start: 4%; inset-inline-end: 14%; }
  .kg-hero__chip:nth-child(2) { inset-block-start: 42%; inset-inline-end: 2%; }
  .kg-hero__chip:nth-child(3) { inset-block-end: 6%; inset-inline-start: 6%; }

  .kg-hero__chip-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }
  .kg-hero__chip-value {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }
  .kg-hero__chip-value em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--kg-green-400);
  }
  .kg-hero__chip--green { border-left-color: var(--kg-green); }
  .kg-hero__chip--green .kg-hero__chip-value { color: var(--kg-green-400); }

  .js .kg-hero__chip { animation: kg-chip-in 0.9s var(--ease-expo) both; animation-delay: calc(1.3s + var(--i) * 0.14s); }
  @keyframes kg-chip-in {
    from { opacity: 0; transform: translateY(14px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* ================================================================== FOOT */
  .kg-hero__foot {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-block-start: clamp(1.5rem, 4vh, 2.5rem);
  }

  .kg-scroll-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
    margin: 0;
  }
  .js .kg-scroll-hint { animation: kg-fade-up 1s var(--ease-expo) 1.4s both; }
  .kg-scroll-hint__track {
    position: relative;
    display: block;
    width: 44px;
    height: 2px;
    background: rgb(255 255 255 / 0.16);
    overflow: hidden;
  }
  .kg-scroll-hint__track i {
    position: absolute;
    inset-block: 0;
    width: 40%;
    background: var(--kg-green);
    animation: kg-scroll-track 2.2s var(--ease-snap) infinite;
  }
  @keyframes kg-scroll-track {
    0% { transform: translateX(-100%); }
    60%, 100% { transform: translateX(250%); }
  }

  .kg-hero__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
    margin: 0;
  }
  .js .kg-hero__trust { animation: kg-fade-up 1s var(--ease-expo) 1.5s both; }
  .kg-hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.42);
  }
  .kg-hero__trust svg { color: var(--kg-green-400); flex: none; }

  /* ============================================================ KEYFRAMES */
  @keyframes kg-fade-up {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ========================================================== RESPONSIVE */
  @media (max-width: 767px) {
    .kg-hero {
      min-height: auto;
      padding-block-start: clamp(5.5rem, 16vh, 7rem);
    }
    /* Mobile recomposes rather than stacks: vehicle leads, copy follows,
       and the stage is allowed to run to the screen edges. */
    .kg-hero__stage {
      width: 140%;
      margin-inline-start: -20%;
      margin-block-end: -4%;
    }
    .kg-hero__sub { max-width: 30ch; }
    .kg-hero__ctas { flex-direction: column; align-items: stretch; }
    .kg-hero__ctas .kg-btn { width: 100%; }
    .kg-hero__cut { inset-inline-start: 66%; }
    .kg-hero__vignette {
      background:
        linear-gradient(to top, rgb(8 10 9 / 0.98) 6%, rgb(8 10 9 / 0.5) 42%, transparent 70%),
        linear-gradient(to bottom, rgb(8 10 9 / 0.75) 0%, transparent 26%);
    }
    .kg-hero__trust { width: 100%; row-gap: 0.5rem; }
    .kg-hero__trust li { font-size: 0.5625rem; }
    .kg-scroll-hint { width: 100%; }
  }

  @media (min-width: 768px) {
    .kg-hero__chips { display: block; }
  }

  @media (min-width: 1024px) {
    .kg-hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas: 'copy stage';
      align-items: center;
    }
    .kg-hero__stage {
      width: 118%;
      margin-inline-start: -2%;
    }
  }

  @media (min-width: 1440px) {
    .kg-hero__inner { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); }
    .kg-hero__stage { width: 116%; }
  }

  /* ======================================================= REDUCED MOTION */
  @media (prefers-reduced-motion: reduce) {
    .js .kg-hero__eyebrow,
    .js .kg-hero__sub,
    .js .kg-hero__ctas,
    .js .kg-hero__tertiary,
    .js .kg-hero__chip,
    .js .kg-scroll-hint,
    .js .kg-hero__trust,
    .js .kg-hero__title .kg-line-mask > span {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .kg-hero__cut-line { animation: none; height: 60%; inset-block-start: 20%; opacity: 0.4; }
    .kg-scroll-hint__track i { animation: none; }
  }
</style>
