---
/**
 * SavingsCalculator — "SEE WHAT ELECTRIC CAN SAVE YOU." (IA slot 06)
 *
 * A transparent, interactive cost model. The design goal is credibility, not
 * hype: the assumptions panel is visible by default (not buried), every figure is
 * labelled as an estimate, and the calculation is simple enough that a visitor
 * could verify it on paper.
 *
 * NO-JS BEHAVIOUR
 * The inputs are real form controls with sensible defaults, and the results are
 * rendered server-side for those defaults. A visitor without JS sees a complete,
 * correct, fully readable calculator — they just cannot change the inputs. Each
 * output also carries its own label, so the numbers make sense without the
 * animation.
 *
 * MOTION
 * Numbers count to their new value rather than snapping, which communicates
 * "this is being computed from your input" — the animation is doing explanatory
 * work, not decoration.
 */
import Icon from './Icon.astro';
import { brand } from '../data/content';

/* Defaults chosen to match a typical Indian commuter two-wheeler */
const DEFAULTS = {
  fuelType: 'petrol',
  dailyKm: 30,
  fuelPrice: 105,
  workingDays: 25,
  mileage: 45,
  evCostPerKm: 1.1,
};

const FUEL_PRICES: Record<string, { price: number; unit: string; label: string; mileageLabel: string }> = {
  petrol: { price: 105, unit: '₹/litre', label: 'Petrol', mileageLabel: 'km/l' },
  diesel: { price: 92, unit: '₹/litre', label: 'Diesel', mileageLabel: 'km/l' },
  cng: { price: 88, unit: '₹/kg', label: 'CNG', mileageLabel: 'km/kg' },
  other: { price: 105, unit: '₹/unit', label: 'Other', mileageLabel: 'km/unit' },
};
---

<section class="kg-calc kg-section kg-section--lg" id="calculator" data-section="calculator" data-calculator>
  <div class="kg-shell">
    <!-- ============================================================== HEAD -->
    <header class="kg-calc__head">
      <div class="kg-calc__head-copy">
        <p class="kg-eyebrow" data-reveal>Savings calculator</p>
        <h2 class="kg-display kg-calc__title" data-reveal="clip">
          See what electric<br /><span class="kg-accent">can save you.</span>
        </h2>
        <p class="kg-lead" data-reveal style="--reveal-delay:120ms">
          Move the sliders to match how you actually drive. The maths updates as you go — and we show
          you every assumption behind it.
        </p>
      </div>

      <!-- The headline result, stated once and large -->
      <div class="kg-calc__headline" data-calc-headline data-reveal="scale">
        <p class="kg-label">Estimated 5-year saving</p>
        <p class="kg-calc__headline-value">
          <span class="kg-calc__currency">₹</span><span class="kg-num" data-calc-out="fiveYear">6,15,000</span>
        </p>
        <p class="kg-calc__headline-note">
          <Icon name="info" size={13} />
          An estimate based on your inputs, not a guarantee
        </p>
      </div>
    </header>

    <div class="kg-calc__body">
      <!-- ============================================================ INPUTS -->
      <form class="kg-calc__inputs" data-calc-form novalidate>
        <fieldset class="kg-calc__group">
          <legend class="kg-calc__legend">Your current vehicle</legend>

          <div class="kg-seg" role="radiogroup" aria-label="Current fuel type">
            {
              Object.entries(FUEL_PRICES).map(([key, cfg], i) => (
                <label class="kg-seg__item">
                  <input
                    type="radio"
                    name="fuelType"
                    value={key}
                    checked={key === DEFAULTS.fuelType}
                    class="kg-seg__input"
                    data-calc-fuel
                  />
                  <span class="kg-seg__label">{cfg.label}</span>
                </label>
              ))
            }
          </div>

          <!-- daily distance -->
          <div class="kg-slider">
            <div class="kg-slider__head">
              <label class="kg-field__label" for="calc-daily">Daily distance</label>
              <output class="kg-slider__value" for="calc-daily">
                <span class="kg-num" data-calc-readout="dailyKm">{DEFAULTS.dailyKm}</span> km
              </output>
            </div>
            <input
              type="range"
              id="calc-daily"
              class="kg-range"
              name="dailyKm"
              min="5"
              max="150"
              step="5"
              value={DEFAULTS.dailyKm}
              data-calc-input
              aria-describedby="calc-daily-hint"
            />
            <div class="kg-slider__scale" aria-hidden="true"><span>5</span><span>150 km</span></div>
            <p class="kg-hint" id="calc-daily-hint">Total distance you cover on a working day.</p>
          </div>

          <!-- fuel price -->
          <div class="kg-slider">
            <div class="kg-slider__head">
              <label class="kg-field__label" for="calc-price">Fuel price</label>
              <output class="kg-slider__value" for="calc-price">
                ₹<span class="kg-num" data-calc-readout="fuelPrice">{DEFAULTS.fuelPrice}</span>
                <em data-calc-unit>₹/litre</em>
              </output>
            </div>
            <input
              type="range"
              id="calc-price"
              class="kg-range"
              name="fuelPrice"
              min="50"
              max="150"
              step="1"
              value={DEFAULTS.fuelPrice}
              data-calc-input
            />
            <div class="kg-slider__scale" aria-hidden="true"><span>₹50</span><span>₹150</span></div>
          </div>

          <!-- working days -->
          <div class="kg-slider">
            <div class="kg-slider__head">
              <label class="kg-field__label" for="calc-days">Working days per month</label>
              <output class="kg-slider__value" for="calc-days">
                <span class="kg-num" data-calc-readout="workingDays">{DEFAULTS.workingDays}</span> days
              </output>
            </div>
            <input
              type="range"
              id="calc-days"
              class="kg-range"
              name="workingDays"
              min="10"
              max="30"
              step="1"
              value={DEFAULTS.workingDays}
              data-calc-input
            />
            <div class="kg-slider__scale" aria-hidden="true"><span>10</span><span>30 days</span></div>
          </div>

          <!-- mileage -->
          <div class="kg-slider">
            <div class="kg-slider__head">
              <label class="kg-field__label" for="calc-mileage">Current mileage</label>
              <output class="kg-slider__value" for="calc-mileage">
                <span class="kg-num" data-calc-readout="mileage">{DEFAULTS.mileage}</span>
                <em data-calc-mileage-unit>km/l</em>
              </output>
            </div>
            <input
              type="range"
              id="calc-mileage"
              class="kg-range"
              name="mileage"
              min="10"
              max="80"
              step="1"
              value={DEFAULTS.mileage}
              data-calc-input
            />
            <div class="kg-slider__scale" aria-hidden="true"><span>10</span><span>80</span></div>
          </div>
        </fieldset>

        <!-- -------------------------------------------------- assumptions -->
        <details class="kg-calc__assumptions" open>
          <summary>
            <Icon name="info" size={14} />
            Assumptions we are using
          </summary>
          <ul>
            <li>
              <span>Electric running cost</span>
              <b>₹{DEFAULTS.evCostPerKm}/km</b>
            </li>
            <li>
              <span>Includes electricity and routine running</span>
              <b>Excludes purchase price and finance</b>
            </li>
            <li>
              <span>Vehicle comparison</span>
              <b>{FUEL_PRICES[DEFAULTS.fuelType].label} vehicle of similar duty cycle</b>
            </li>
          </ul>
          <p>
            We do not subtract the purchase price of the vehicle, insurance, tyres or servicing from
            these figures — this compares running cost only. Real-world results depend on your route,
            load, driving style, electricity tariff and battery age.
          </p>
        </details>
      </form>

      <!-- =========================================================== RESULTS -->
      <div class="kg-calc__results" data-calc-results>
        <!-- the three-step comparison, revealed as a chain -->
        <div class="kg-calc__chain">
          <article class="kg-calc__step kg-calc__step--cost">
            <p class="kg-label">Current monthly cost</p>
            <p class="kg-calc__value">
              <span class="kg-calc__cur">₹</span><span class="kg-num" data-calc-out="monthlyFuel">13,125</span>
            </p>
            <p class="kg-calc__sub" data-calc-note="fuel">—</p>
          </article>

          <span class="kg-calc__arrow" aria-hidden="true">
            <Icon name="arrow-down" size={18} />
          </span>

          <article class="kg-calc__step kg-calc__step--ev">
            <p class="kg-label">Estimated EV cost</p>
            <p class="kg-calc__value">
              <span class="kg-calc__cur">₹</span><span class="kg-num" data-calc-out="monthlyEv">825</span>
            </p>
            <p class="kg-calc__sub" data-calc-note="ev">—</p>
          </article>

          <span class="kg-calc__arrow kg-calc__arrow--green" aria-hidden="true">
            <Icon name="arrow-down" size={18} />
          </span>

          <article class="kg-calc__step kg-calc__step--save">
            <p class="kg-label">Potential monthly saving</p>
            <p class="kg-calc__value">
              <span class="kg-calc__cur">₹</span><span class="kg-num" data-calc-out="monthlySaving">12,300</span>
            </p>
            <p class="kg-calc__sub">Estimated, based on your inputs</p>
            <!-- visual saving bar, width is the saving ratio -->
            <span class="kg-calc__bar" aria-hidden="true">
              <i data-calc-bar style="width: 92%"></i>
            </span>
          </article>
        </div>

        <!-- annual / five year grid -->
        <dl class="kg-calc__totals">
          <div>
            <dt>Annual fuel cost</dt>
            <dd class="kg-num" data-calc-out="annualFuel">₹1,57,500</dd>
          </div>
          <div>
            <dt>Annual EV cost</dt>
            <dd class="kg-num" data-calc-out="annualEv">₹9,900</dd>
          </div>
          <div class="kg-calc__totals-highlight">
            <dt>Annual saving</dt>
            <dd class="kg-num" data-calc-out="annualSaving">₹1,47,600</dd>
          </div>
          <div class="kg-calc__totals-highlight">
            <dt>5-year saving</dt>
            <dd class="kg-num" data-calc-out="fiveYear">₹7,38,000</dd>
          </div>
          <div>
            <dt>Distance per year</dt>
            <dd class="kg-num" data-calc-out="annualKm">9,000 km</dd>
          </div>
        </dl>

        <!-- ---------------------------------------------------------- CTAs -->
        <div class="kg-calc__actions">
          <button
            type="button"
            class="kg-btn kg-btn--lg"
            data-calc-cta
            data-track="savings_calculator_complete"
            data-track-source="savings-calculator"
          >
            <Icon name="calculator" size={17} />
            Calculate my savings
          </button>
          <button
            type="button"
            class="kg-btn kg-btn--outline"
            data-lead-open
            data-lead-type="callback"
            data-lead-intent="medium"
            data-lead-source="savings-calculator"
            data-track="savings_expert_click"
          >
            <Icon name="phone" size={17} />
            Talk to an EV expert
          </button>
        </div>

        <p class="kg-calc__disclaimer">
          <Icon name="info" size={13} />
          <span>
            All figures are illustrative estimates computed from the values you enter. They are not a
            quotation, a guarantee of cost, or a promise of savings. Verify current pricing and
            running costs with your nearest {brand.name} dealer.
          </span>
        </p>

        <!-- no-JS: the phone route is always available -->
        <p class="kg-calc__fallback">
          Prefer to talk it through? Call
          <a href={brand.phoneHref}>{brand.phone}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .kg-calc {
    position: relative;
    background: var(--kg-mist);
    color: var(--kg-ink);
    --s-bg: var(--kg-mist);
    --s-bg-alt: #fff;
    --s-fg: var(--kg-ink);
    --s-fg-muted: #55606a;
    --s-fg-subtle: #7e898f;
    --s-line: #e2e8e5;
    --s-line-strong: #cfd8d4;
    --s-accent: var(--kg-green-700);
    --s-accent-bg: var(--kg-green);
  }

  /* ------------------------------------------------------------------ head */
  .kg-calc__head {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
  }
  .kg-calc__head-copy { display: grid; gap: 0.75rem; }
  .kg-calc__title { font-size: var(--fs-d2); max-width: 16ch; }

  .kg-calc__headline {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: linear-gradient(150deg, var(--kg-charcoal) 0%, var(--kg-ink) 100%);
    color: #fff;
    border-radius: var(--r-4);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .kg-calc__headline::after {
    content: '';
    position: absolute;
    inset-block-start: -40%;
    inset-inline-end: -20%;
    width: 70%;
    height: 150%;
    background: linear-gradient(118deg, transparent 42%, rgb(0 200 83 / 0.2) 68%, transparent 90%);
    transform: rotate(var(--diag-soft));
    pointer-events: none;
  }
  .kg-calc__headline .kg-label { color: var(--kg-green-400); position: relative; }
  .kg-calc__headline-value {
    display: flex;
    align-items: baseline;
    gap: 0.05em;
    margin: 0.5rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    position: relative;
  }
  .kg-calc__currency { font-size: 0.55em; color: var(--kg-green-400); }
  .kg-calc__headline-note {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.6875rem;
    color: rgb(255 255 255 / 0.5);
    position: relative;
  }

  /* ------------------------------------------------------------------ body */
  .kg-calc__body { display: grid; gap: clamp(1.5rem, 4vw, 3rem); }

  /* ---------------------------------------------------------------- inputs */
  .kg-calc__inputs {
    background: #fff;
    border: 1px solid var(--s-line);
    border-radius: var(--r-4);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .kg-calc__group { border: 0; padding: 0; margin: 0; }
  .kg-calc__legend {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--kg-green-700);
    padding: 0;
    margin-block-end: 1rem;
  }

  /* segmented fuel control */
  .kg-seg {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border: 1px solid var(--s-line-strong);
    border-radius: var(--r-2);
    overflow: hidden;
    margin-block-end: 1.5rem;
  }
  .kg-seg__item { position: relative; }
  .kg-seg__input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .kg-seg__label {
    display: grid;
    place-items: center;
    min-height: 46px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--s-fg-muted);
    cursor: pointer;
    border-inline-end: 1px solid var(--s-line-strong);
    transition: all var(--dur-2) var(--ease-kinetic);
  }
  .kg-seg__item:last-child .kg-seg__label { border-inline-end: 0; }
  .kg-seg__label:hover { background: var(--kg-green-050); color: var(--kg-green-700); }
  .kg-seg__input:checked + .kg-seg__label {
    background: var(--kg-green);
    color: #00240f;
  }
  .kg-seg__input:focus-visible + .kg-seg__label {
    outline: var(--focus-ring);
    outline-offset: -2px;
  }

  /* --------------------------------------------------------------- sliders */
  .kg-slider { margin-block-start: 1.5rem; }
  .kg-slider__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 0.25rem;
  }
  .kg-slider__value {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 2vw, 1.3125rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--kg-ink);
  }
  .kg-slider__value em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--s-fg-subtle);
  }
  .kg-slider__scale {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    color: var(--s-fg-subtle);
    margin-block-start: -0.5rem;
  }

  /* ----------------------------------------------------------- assumptions */
  .kg-calc__assumptions {
    margin-block-start: 1.75rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--s-line);
  }
  .kg-calc__assumptions summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--s-fg-muted);
    padding-block: 0.25rem;
    transition: color var(--dur-2);
  }
  .kg-calc__assumptions summary:hover { color: var(--kg-green-700); }
  .kg-calc__assumptions summary svg { color: var(--kg-green-700); flex: none; }
  .kg-calc__assumptions ul {
    display: grid;
    gap: 0.5rem;
    margin-block: 0.875rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--s-line);
  }
  .kg-calc__assumptions li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.75rem;
  }
  .kg-calc__assumptions li span { color: var(--s-fg-subtle); }
  .kg-calc__assumptions li b { font-family: var(--font-mono); font-weight: 500; text-align: end; }
  .kg-calc__assumptions p {
    font-size: 0.6875rem;
    line-height: 1.65;
    color: var(--s-fg-subtle);
    margin: 0;
  }

  /* -------------------------------------------------------------- results */
  .kg-calc__results { display: grid; gap: 0; }

  .kg-calc__chain { display: grid; gap: 0; }

  .kg-calc__step {
    padding: 1.125rem 1.25rem;
    background: #fff;
    border: 1px solid var(--s-line);
    border-radius: var(--r-3);
    position: relative;
    transition: border-color var(--dur-3) var(--ease-kinetic);
  }
  .kg-calc__step--cost { border-inline-start: 3px solid var(--kg-graphite-2); }
  .kg-calc__step--ev { border-inline-start: 3px solid var(--kg-green); }
  .kg-calc__step--save {
    border-inline-start: 3px solid var(--kg-green);
    background: linear-gradient(140deg, var(--kg-green-050) 0%, #fff 62%);
  }

  .kg-calc__value {
    display: flex;
    align-items: baseline;
    gap: 0.04em;
    margin: 0.4rem 0 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--kg-ink);
  }
  .kg-calc__step--save .kg-calc__value { color: var(--kg-green-700); }
  .kg-calc__cur { font-size: 0.6em; color: var(--s-fg-subtle); }
  .kg-calc__step--save .kg-calc__cur { color: var(--kg-green-700); opacity: 0.65; }

  .kg-calc__sub {
    margin: 0;
    font-size: 0.75rem;
    color: var(--s-fg-subtle);
  }

  .kg-calc__arrow {
    display: grid;
    place-items: center;
    height: 34px;
    color: var(--kg-steel);
  }
  .kg-calc__arrow--green { color: var(--kg-green); }

  /* saving ratio bar — the number made visual */
  .kg-calc__bar {
    display: block;
    height: 5px;
    margin-block-start: 0.875rem;
    background: rgb(18 22 26 / 0.08);
    border-radius: 3px;
    overflow: hidden;
  }
  .kg-calc__bar i {
    display: block;
    height: 100%;
    background: var(--kg-green);
    border-radius: 3px;
    transition: width var(--dur-4) var(--ease-expo);
  }

  /* --------------------------------------------------------------- totals */
  .kg-calc__totals {
    display: grid;
    gap: 0;
    margin: 1.25rem 0 0;
    border-block: 1px solid var(--s-line);
  }
  .kg-calc__totals > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-block-end: 1px solid var(--s-line);
  }
  .kg-calc__totals > div:last-child { border-block-end: 0; }
  .kg-calc__totals dt {
    font-size: 0.8125rem;
    color: var(--s-fg-muted);
  }
  .kg-calc__totals dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }
  .kg-calc__totals-highlight dt { color: var(--kg-ink); font-weight: 500; }
  .kg-calc__totals-highlight dd { color: var(--kg-green-700); }

  /* ---------------------------------------------------------------- CTAs */
  .kg-calc__actions {
    display: grid;
    gap: 0.625rem;
    margin-block-start: 1.5rem;
  }

  .kg-calc__disclaimer {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin: 1.125rem 0 0;
    font-size: 0.6875rem;
    line-height: 1.65;
    color: var(--s-fg-subtle);
  }
  .kg-calc__disclaimer svg { flex: none; margin-block-start: 0.15rem; }

  .kg-calc__fallback {
    margin: 0.875rem 0 0;
    font-size: 0.75rem;
    color: var(--s-fg-subtle);
  }
  .kg-calc__fallback a {
    color: var(--kg-green-700);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ============================================================ RESPONSIVE */
  @media (min-width: 640px) {
    .kg-calc__actions { grid-auto-flow: column; }
    .kg-calc__actions .kg-btn { width: 100%; }
  }

  @media (min-width: 1024px) {
    .kg-calc__head { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); }
    .kg-calc__body { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: start; }
    .kg-calc__results { position: sticky; inset-block-start: 5.5rem; }
  }

  @media (min-width: 1280px) {
    .kg-calc__body { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  }

  /* The chain reads as a vertical flow on narrow screens by design — the
     down-arrows are literally showing the calculation order. */
  @media (max-width: 1023px) {
    .kg-calc__chain { gap: 0; }
  }

  /* ==================================================== NUMBER FLASH STATE */
  /* Applied briefly by JS when a value changes, so the eye can find it. */
