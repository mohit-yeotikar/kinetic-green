---
import Icon from './Icon.astro';
const monthlyKm = 30 * 25;
const fuel = monthlyKm / 45 * 105;
const electric = monthlyKm * 1.1;
const annualSaving = (fuel - electric) * 12;
const fmt = (n: number) => Math.round(n).toLocaleString('en-IN');
---
<section class="savings-section section-space" id="calculator" data-section="calculator" data-calculator>
  <div class="kg-shell savings-layout">
    <div class="savings-copy"><p class="editorial-label">LESS ON FUEL. MORE ON LIFE.</p><h2>Small switch.<br />Big difference.</h2><p>Your everyday kilometres could go a little further for your wallet. See what switching to electric could save in running costs.</p>
      <form data-calc-form class="savings-form">
        <label for="calc-daily">How far do you ride each day?<output for="calc-daily"><span data-calc-readout="dailyKm">30</span> <span>km</span></output></label>
        <input class="kg-range" type="range" id="calc-daily" name="dailyKm" min="5" max="150" step="5" value="30" data-calc-input />
        <div class="range-scale"><span>5 km</span><span>150 km</span></div>
        <details class="savings-settings"><summary>Adjust the assumptions <Icon name="plus" size={15} /></summary>
          <div class="savings-settings__grid">
            <label>Petrol price (₹/litre)<input type="number" name="fuelPrice" value="105" min="50" max="200" step="1" data-calc-input required /></label>
            <label>Petrol mileage (km/l)<input type="number" name="mileage" value="45" min="10" max="100" step="1" data-calc-input required /></label>
            <label>Riding days per month<input type="number" name="workingDays" value="25" min="1" max="31" step="1" data-calc-input required /></label>
          </div>
          <p>EV running-cost assumption: ₹1.10/km. This is an illustrative comparison, not a model-specific quote. Excludes vehicle purchase, finance, insurance, servicing and battery replacement. Actual costs vary.</p>
        </details>
      </form>
    </div>
    <div class="savings-result" aria-live="polite" aria-atomic="true">
      <p class="editorial-label">YOUR POTENTIAL YEARLY SAVINGS</p>
      <p class="savings-result__total">₹<span data-calc-out="annualSaving">{fmt(annualSaving)}</span><span class="savings-result__asterisk">*</span></p>
      <p class="savings-result__caption">A little more room for what matters.</p>
      <div class="cost-comparison">
        <div class="cost-comparison__row"><span>Petrol / month</span><b>₹<span data-calc-out="monthlyFuel">{fmt(fuel)}</span></b></div><div class="comparison-track"><span class="comparison-track__petrol"></span></div>
        <div class="cost-comparison__row"><span>Electric / month</span><b>₹<span data-calc-out="monthlyEv">{fmt(electric)}</span></b></div><div class="comparison-track"><span data-electric-bar style={`width:${electric/fuel*100}%`}></span></div>
      </div>
      <p class="fine-print">*Estimated running-cost savings only, based on your inputs. Not a guarantee. Open the assumptions to see the comparison.</p>
      <noscript><p class="fine-print">Default estimate: 30 km/day, 25 days/month, 45 km/l, petrol at ₹105/litre. Enable JavaScript to adjust.</p></noscript>
    </div>
  </div>
</section>
