---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/premium/Nav.astro';
import Story from '../components/premium/Story.astro';
import Lifestyle from '../components/premium/Lifestyle.astro';
import Pink from '../components/premium/Pink.astro';
import Range from '../components/premium/Range.astro';
import Proof from '../components/premium/Proof.astro';
import Savings from '../components/premium/Savings.astro';
import Ownership from '../components/premium/Ownership.astro';
import Dealers from '../components/premium/Dealers.astro';
import Closing from '../components/premium/Closing.astro';
import Footer from '../components/premium/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
---
<BaseLayout title="Kinetic Green — Chal meri Luna. Now electric." description="Meet the electric E-Luna. Kinetic Green electric two- and three-wheelers with real range, real prices and running costs that make petrol feel expensive." path="/" bodyClass="kg-premium">
  <Nav />
  <main id="main">
    <Story />
    <Range />
    <Lifestyle />
    <Pink />
    <Proof />
    <Savings />
    <Ownership />
    <Dealers />
    <Closing />
  </main>
  <Footer />
  <LeadModal />
</BaseLayout>
