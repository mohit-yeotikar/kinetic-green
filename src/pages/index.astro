---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import VehicleExplorer from '../components/VehicleExplorer.astro';
import SavingsCalculator from '../components/SavingsCalculator.astro';
import Ownership from '../components/Ownership.astro';
import DealerFinder from '../components/DealerFinder.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
---
<BaseLayout title="Kinetic Green — Go your own way. Go electric." description="Meet the electric side of everyday life. Explore Kinetic Green vehicles, estimate your running-cost savings and plan a test ride." path="/" bodyClass="kg-premium">
  <Header />
  <main id="main">
    <Hero />
    <VehicleExplorer />
    <SavingsCalculator />
    <Ownership />
    <DealerFinder />
    <FinalCTA />
  </main>
  <Footer />
  <LeadModal />
</BaseLayout>
