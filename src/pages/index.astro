---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/premium/Nav.astro';
import Hero from '../components/premium/Hero.astro';
import LeadModal from '../components/LeadModal.astro';
---
<BaseLayout title="Kinetic Green — The icon. Recharged." description="Meet the electric E-Luna. Kinetic Green electric two- and three-wheelers with real range, real prices and running costs that make petrol feel expensive." path="/" bodyClass="kg-premium">
  <Nav />
  <main id="main">
    <Hero />
    <section class="p-curtain" id="range" style="min-height:100svh;background:#fff;border-radius:32px 32px 0 0;box-shadow:0 -24px 60px -30px rgb(11 15 13/.2);position:relative;z-index:2;margin-top:-100svh"></section>
  </main>
  <LeadModal />
</BaseLayout>
