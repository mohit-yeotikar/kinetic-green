<script>
  // Hero product tilt (pointer) + light nav state. Reveals/counters/kinetic
  // transition/magnetic all come from the shared motion system in main.ts.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const product = document.querySelector<HTMLElement>('[data-ch-tilt]');
  const stage = product?.closest<HTMLElement>('.ch-hero__stage');
  if (product && stage && !reduce && matchMedia('(hover: hover)').matches) {
    stage.addEventListener('pointermove', (e) => {
      const r = stage.getBoundingClientRect();
      const dx = ((e.clientX - r.left) / r.width - 0.5) * 2;
      const dy = ((e.clientY - r.top) / r.height - 0.5) * 2;
      product.style.setProperty('--tilt-x', `${(dx * 10).toFixed(1)}px`);
      product.style.setProperty('--tilt-y', `${(dy * 10).toFixed(1)}px`);
    });
    stage.addEventListener('pointerleave', () => {
      product.style.setProperty('--tilt-x', '0px');
      product.style.setProperty('--tilt-y', '0px');
    });
  }
  const nav = document.querySelector<HTMLElement>('[data-ch-nav]');
  if (nav) {
    const onScroll = () => nav.dataset.state = window.scrollY > 20 ? 'scrolled' : 'top';
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
