{
  "name": "webapp",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "astro dev --host 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name webapp",
    "astro": "astro",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl -s -o /dev/null -w \"%{http_code}\\n\" http://localhost:3000"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "wrangler": "^4.110.0"
  }
}
